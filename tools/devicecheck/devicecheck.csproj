<Project Sdk="Microsoft.NET.Sdk">
  <!-- Directory.Build.props builds for win-x64, so on Linux the apphost is a
       Windows .exe: "dotnet run" started it and the runner answered "Exec format
       error" (WSL hid this by running .exe files through interop). Without an
       apphost, dotnet run starts the dll through dotnet on any system. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'"><UseAppHost>false</UseAppHost></PropertyGroup>
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/DispCtrl.Core/DispCtrl.Core.csproj" /></ItemGroup>
</Project>
