<Project Sdk="Microsoft.NET.Sdk">
  <!-- See devicecheck.csproj: without an apphost, dotnet run starts the dll
       through dotnet on Linux instead of trying to execute a Windows .exe. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'"><UseAppHost>false</UseAppHost></PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DispCtrl.Core/DispCtrl.Core.csproj" />
    <ProjectReference Include="../../src/DispCtrl.Display/DispCtrl.Display.csproj" />
  </ItemGroup>
</Project>
