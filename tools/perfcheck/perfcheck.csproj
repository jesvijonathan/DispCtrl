<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- For UIAutomationClient only: the ui suite drives the quick panel the
         way a person does, through the tray icon and its controls. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWPF leaves System.IO out of the implicit usings (WPF has a Path too). -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DispCtrl.Display/DispCtrl.Display.csproj" />
    <ProjectReference Include="../../src/DispCtrl.Control/DispCtrl.Control.csproj" />
  </ItemGroup>
</Project>
