<Project>

  <PropertyGroup>
    <!-- Shipping version for local builds and packaging defaults. Use
         build/Update-Version.ps1, or Release's automatic version update,
         before tagging. Stable tags must agree with this version. -->
    <DispCtrlVersion>0.1.6</DispCtrlVersion>
    <Version Condition="'$(Version)' == ''">$(DispCtrlVersion)</Version>

    <!-- stable, beta or test; a build from source is dev. Publish.ps1 passes
         the release channel. Stable compiles routine diagnostics out
         (BuildInfo.Diagnostics); the others show their version in the title. -->
    <DispCtrlChannel Condition="'$(DispCtrlChannel)' == ''">dev</DispCtrlChannel>
    <DefineConstants Condition="'$(DispCtrlChannel)' == 'stable'">$(DefineConstants);DISPCTRL_STABLE</DefineConstants>

    <!-- Presets are shelved until the beta implementation is ready. -->
    <EnableBetaPresets Condition="'$(EnableBetaPresets)' == ''">false</EnableBetaPresets>
    <DefineConstants Condition="'$(EnableBetaPresets)' == 'true'">$(DefineConstants);BETA_PRESETS</DefineConstants>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- x64 only for now. The shell interop is not arm64-tested and shipping an
         untested arm64 slice is worse than shipping none. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Warnings are the cheapest bug detector available in interop code, where
         a silent marshalling mistake reads as a runtime crash three layers away. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <Authors>Jesvi Jonathan</Authors>
    <Company>Jesvi Jonathan</Company>
    <Product>DispCtrl</Product>
    <Description>Per-monitor display, brightness, taskbar and OLED controls for Windows, with a scriptable command line.</Description>
    <Copyright>Copyright (c) 2026 Jesvi Jonathan (jesvi22j@gmail.com, www.jesvi.net). MIT licence.</Copyright>
    <RepositoryUrl>https://github.com/jesvijonathan/DispCtrl</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jesvijonathan/DispCtrl</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DispCtrlChannel" Value="$(DispCtrlChannel)" />
    <!-- The projection of the whole Windows API: ~25 MB of IL that ReadyToRun
         made 56 MB, in every published folder, for the handful of types DispCtrl
         touches. Those are compiled when first used instead. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

</Project>
