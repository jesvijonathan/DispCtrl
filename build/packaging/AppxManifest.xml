<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap5 desktop desktop4 rescap">
  <!-- The Store's identity, from Partner Center > Product identity. Not a
       secret: every published package carries it. build/Package.ps1 packs with
       it unless told otherwise; CI's validation build passes a development one. -->
  <Identity Name="JustVStudio.DispCtrl" Publisher="CN=C082656A-D91F-4532-A22C-94A2FE40C410" Version="0.1.0.0" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>DispCtrl</DisplayName>
    <PublisherDisplayName>JustVStudio</PublisherDisplayName>
    <Description>Display, brightness, taskbar and OLED controls for Windows, with a scriptable CLI.</Description>
    <Logo>PackageAssets\Logo50.png</Logo>
  </Properties>
  <Resources><Resource Language="en-us"/></Resources>
  <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0"/></Dependencies>
  <Applications>
    <Application Id="App" Executable="DispCtrl.App.exe" EntryPoint="Windows.FullTrustApplication" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements DisplayName="DispCtrl" Description="Control your displays and desktop"
                          BackgroundColor="transparent" Square44x44Logo="PackageAssets\Logo44.png" Square150x150Logo="PackageAssets\Logo150.png"/>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="dispctrl.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console"><uap5:ExecutionAlias Alias="dispctrl.exe"/></uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- Enabled: the engine is what makes DispCtrl work with the window shut
             (tray icon, hotkeys, taskbar, night light). Windows only honours it
             after the app has been opened once; the app also asks once itself,
             for installs that predate this. -->
        <desktop:Extension Category="windows.startupTask" Executable="DispCtrl.Engine.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DispCtrlEngine" Enabled="true" DisplayName="DispCtrl engine"/>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust"/></Capabilities>
</Package>
