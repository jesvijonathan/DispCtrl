#!/bin/sh
# Only on removal: an upgrade keeps the engine enabled. Running engines are
# not killed here - each user's stops at logout and puts its ramps back, and
# "dispctrl-linux engine stop" stops one now.
set -e
if [ "$1" = "remove" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl --global disable dispctrl-linux-engine.service >/dev/null 2>&1 || true
fi
exit 0
