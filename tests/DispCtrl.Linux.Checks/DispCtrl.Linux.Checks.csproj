<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Linux client's checks. Needs no monitors and no X server: the X
       display is pointed somewhere that cannot answer, so nothing here can
       change a ramp, and CI runs it on every push. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetPlatformMinVersion />
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DispCtrl.Linux.Core/DispCtrl.Linux.Core.csproj" />
    <!-- Built alongside, so the engine can be started as a real process. -->
    <ProjectReference Include="../../src/DispCtrl.Linux/DispCtrl.Linux.csproj" />
  </ItemGroup>
</Project>
