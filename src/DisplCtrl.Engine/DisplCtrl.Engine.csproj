<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: the engine runs at logon, and a console app would put a window
         on screen for the entire session. CLI commands still print, by
         attaching to the parent console when there is one — see TryAttachConsole. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <AssemblyName>DisplCtrl.Engine</AssemblyName>
    <RootNamespace>DisplCtrl.Engine</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Native AOT. Requires the MSVC linker at PUBLISH time only; a plain
         `dotnet build` and `dotnet run` work without it, so day-to-day
         development never depends on the C++ toolchain being present. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>true</StackTraceSupport>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>

    <!-- The engine is pure Win32 + WinRT interop. No XAML, no reflection-heavy
         binding, which is exactly the shape Native AOT handles cleanly. -->
    <EnableComHosting>false</EnableComHosting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Built-in COM, turned back on. PublishAot switches it off, and that was
         fine while the engine only did taskbar work. Per-app presets made the
         engine set brightness, and the built-in panel's brightness goes through
         WMI (System.Management), which is built-in COM - so every rule that
         touched the laptop screen died with NotSupported_COM.

         This is a debt, not a fix: it is the one thing now standing between the
         engine and Native AOT. Paying it off means reaching WMI through
         source-generated COM interfaces the way Wallpaper.cs already reaches
         IDesktopWallpaper, at which point this line goes away. Leaving PublishAot
         set means the publish-time warning keeps saying so. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Memory and thread trimming for a process that sits resident all day.
         Concurrent GC buys throughput on a busy server by running collection on
         a dedicated background thread; this engine allocates almost nothing, so
         that thread and its heap reservation are pure overhead. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>

    <!-- Features the engine does not use. Each one dropped is startup work not
         done and metadata not mapped. -->
    <!-- Tiered compilation runs a background thread that re-JITs hot methods.
         This engine's hot path is a few dozen lines that will never benefit
         enough to pay for a resident thread, so compile once at full
         optimisation instead. Costs a little startup time, saves a thread. -->
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>

    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <NullabilityInfoContextSupport>false</NullabilityInfoContextSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>

    <!-- Write CsWin32's output to obj/generated so the exact generated
         signatures can be read. In interop-heavy code, guessing at a marshalled
         shape is how silent corruption gets in. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source-generated P/Invoke straight from the official Win32 metadata.
         Hand-written DllImport is where interop bugs live: a wrong struct
         packing or charset reads as a crash three layers away from the cause. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisplCtrl.Core\DisplCtrl.Core.csproj" />

    <!-- Added when per-app presets landed. DisplCtrl.Display used to be the app's
         alone, on the reasoning that every call in it is a deliberate user
         action. Per-app rules make those same calls background work, so that
         reasoning no longer holds and the engine needs them too. -->
    <ProjectReference Include="..\DisplCtrl.Display\DisplCtrl.Display.csproj" />
  </ItemGroup>

</Project>
