<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <AssemblyName>DispCtrl.Display</AssemblyName>
    <RootNamespace>DispCtrl.Display</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- The internal laptop panel has no DDC/CI, so its backlight can only be
         reached through WMI. System.Management is not Native-AOT friendly,
         which is exactly why this lives in its own assembly: the app can
         reference it, and the AOT engine never has to. -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DispCtrl.Core\DispCtrl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\devices\*.md" Exclude="..\..\devices\README.md"
          Link="devices\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Reviewed device definitions, beside every executable that resolves them. -->
    <None Include="..\..\devices\definitions\*.json"
          Link="devices\definitions\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
