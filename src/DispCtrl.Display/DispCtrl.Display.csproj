<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <AssemblyName>DispCtrl.Display</AssemblyName>
    <!-- The file description: what Task Manager, Startup apps and the tray settings call it. -->
    <AssemblyTitle>DispCtrl display control</AssemblyTitle>
    <RootNamespace>DispCtrl.Display</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- The internal laptop panel has no DDC/CI, so its backlight can only be
         reached through WMI. System.Management is not Native-AOT friendly,
         which is exactly why this lives in its own assembly: the app can
         reference it, and the AOT engine never has to. -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DispCtrl.Core\DispCtrl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reviewed device definitions, beside every executable that resolves them,
         in the repository's layout (DeviceLayout). Records and the index stay in
         the repository: the app never reads them, and with thousands of models
         they would be most of the download. -->
    <None Include="..\..\devices\common.json" Condition="Exists('..\..\devices\common.json')"
          Link="devices\common.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\devices\**\brand.json;..\..\devices\**\definition.json"
          Link="devices\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
