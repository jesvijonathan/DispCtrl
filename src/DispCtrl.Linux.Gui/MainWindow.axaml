<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DispCtrl.Linux.Gui"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="640"
        Width="680" Height="640" MinWidth="520" MinHeight="420"
        x:Class="DispCtrl.Linux.Gui.MainWindow"
        Title="DispCtrl"
        Icon="avares://dispctrl-linux-gui/Assets/dispctrl.png"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <DockPanel Margin="24,20,24,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="DispCtrl" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Name="EngineLine" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Name="RestoreButton" Click="OnRestoreClick" AutomationProperties.Name="Restore"
                        ToolTip.Tip="Night light off, no dimming, every ramp back to normal">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:FASymbolIcon Symbol="Undo" FontSize="16" />
                        <TextBlock Text="Restore" />
                    </StackPanel>
                </Button>
                <Button Name="RescanButton" Click="OnRescanClick" AutomationProperties.Name="Rescan"
                        ToolTip.Tip="Look for displays again: a few seconds of DDC/CI traffic per monitor">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:FASymbolIcon Symbol="Refresh" FontSize="16" />
                        <TextBlock Text="Rescan" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer>
            <StackPanel Spacing="4">
                <TextBlock Text="Night light" FontWeight="SemiBold" Margin="0,4,0,4" />
                <ui:FASettingsExpanderItem Name="NightLightCard" Content="Night light"
                                           Description="Warms every display through its gamma ramp">
                    <ui:FASettingsExpanderItem.IconSource>
                        <ui:FASymbolIconSource Symbol="WeatherMoon" />
                    </ui:FASettingsExpanderItem.IconSource>
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch Name="NightLightSwitch" OnContent="On" OffContent="Off"
                                      AutomationProperties.Name="Night light" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Strength" Name="StrengthCard">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Name="StrengthSlider" Width="200" Minimum="0" Maximum="100"
                                    AutomationProperties.Name="Night light strength" />
                            <TextBlock Name="StrengthText" Width="64" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Schedule"
                                           Description="On: warm only between these times. The engine follows it.">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TimePicker Name="FromPicker" ClockIdentifier="24HourClock" MinuteIncrement="5"
                                        AutomationProperties.Name="Night light from" />
                            <TextBlock Text="to" VerticalAlignment="Center" />
                            <TimePicker Name="ToPicker" ClockIdentifier="24HourClock" MinuteIncrement="5"
                                        AutomationProperties.Name="Night light to" />
                            <ToggleSwitch Name="ScheduleSwitch" OnContent="" OffContent=""
                                          AutomationProperties.Name="Follow the schedule" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <TextBlock Name="NightLightStatus" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="4,0,0,0" />

                <TextBlock Text="Displays" FontWeight="SemiBold" Margin="0,16,0,4" />
                <TextBlock Name="ScanStatus" FontSize="12" Opacity="0.7" Margin="4,0,0,4" />
                <ItemsControl Name="Rows">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MonitorRowViewModel">
                            <ui:FASettingsExpanderItem Content="{Binding Title}" Description="{Binding Subtitle}">
                                <ui:FASettingsExpanderItem.IconSource>
                                    <ui:FASymbolIconSource Symbol="{Binding Icon}" />
                                </ui:FASettingsExpanderItem.IconSource>
                                <ui:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                                IsVisible="{Binding IsInteractive}">
                                        <TextBlock Text="{Binding Status}" MaxWidth="180" FontSize="11" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding Status}" />
                                        <Slider Width="180" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                Value="{Binding Value, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding Title}" />
                                        <TextBlock Text="{Binding ValueText}" Width="44" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:FASettingsExpanderItem.Footer>
                            </ui:FASettingsExpanderItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
