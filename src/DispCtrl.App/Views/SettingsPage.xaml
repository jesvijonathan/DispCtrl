<Page x:Class="DispCtrl.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="using:DispCtrl.App.Views"
      xmlns:vm="using:DispCtrl.App.ViewModels"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">

  <ScrollViewer Padding="0,0,0,32">
    <!-- Stretch with no MaxWidth. The cap was the problem: a Stretch panel
           with a MaxWidth centres itself once the window exceeds that width,
           which is what pushed content off to one side. Pinning it Left instead
           fixed the drift but made the panel size to its content, so cards
           stopped filling. Filling at every width is what Windows Settings
           does, and the side padding already keeps line length sane. -->
      <StackPanel Padding="36,12,36,0" Spacing="0"
                  HorizontalAlignment="Stretch">

      <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="DispCtrl itself. Display settings live on the Displays page; taskbar behaviour has its own."
                 Style="{StaticResource BodyTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Margin="0,4,0,28"/>

      <views:EngineSettings/>

      <views:StartupSettings/>

      <TextBlock Text="Monitors"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <!-- Power Display's crash guard. Here rather than on each display: the
           guard is DispCtrl's, and a blocked monitor may not even be attached. -->
      <tk:SettingsExpander Header="Guard against the DDC/CI crash"
                           Description="{x:Bind ViewModel.DdcGuardSummary, Mode=OneWay}">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE83D;"/>
        </tk:SettingsExpander.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.DdcGuardEnabled, Mode=TwoWay}" AutomationProperties.Name="DdcGuardEnabled"/>
        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="What it does"
                           Description="A monitor with a malformed capabilities string can trigger a Windows bug that crashes the computer when it is read. If Windows goes down during a read, DispCtrl stops talking to that monitor over DDC/CI until you allow it again, and its brightness falls back to software dimming."/>
          <tk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"
                           Header="Blocked monitors"
                           Visibility="{x:Bind ViewModel.BlockedMonitorsVisibility, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.BlockedMonitors}" Margin="0,4,0,8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlockedMonitor">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{x:Bind Name}"/>
                      <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Allow again" Click="OnAllowDdc" Tag="{x:Bind}" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind AutomationName}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <TextBlock Text="Diagnostics"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <tk:SettingsCard Header="Write a log"
                       Description="Records starts, layout changes and errors. The only way to diagnose a failure after the fact.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE9D9;"/>
        </tk:SettingsCard.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.Logging, Mode=TwoWay}"/>
      </tk:SettingsCard>

      <TextBlock Text="Updates and maintenance"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <InfoBar x:Name="MaintenanceResult" IsOpen="False" IsClosable="True" Margin="0,0,0,8"/>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,8"
               Visibility="{x:Bind ViewModel.UpdateAvailableVisibility, Mode=OneWay}"
               Title="A new version is available"
               Message="{x:Bind ViewModel.UpdateAvailableText, Mode=OneWay}">
        <!-- ActionButton takes a single button; two go in the content. -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
          <Button Content="Download" Click="OnDownloadUpdate" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="DownloadUpdate"/>
          <Button Content="Not now" Click="OnSkipUpdate" AutomationProperties.Name="SkipUpdate"/>
        </StackPanel>
      </InfoBar>

      <tk:SettingsCard x:Name="UpdateCard" Header="Updates"
                       Description="{x:Bind ViewModel.UpdateDescription, Mode=OneWay}">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE895;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button Content="Check for updates" Click="OnCheckUpdates" IsEnabled="{x:Bind ViewModel.UpdateCheckReady, Mode=OneWay}"
                AutomationProperties.Name="CheckForUpdates"/>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Check for updates automatically"
                       Visibility="{x:Bind ViewModel.UpdateSwitchVisibility}"
                       Description="Once a day, DispCtrl asks GitHub for the newest release's version number and tells you when there is one. Nothing about you or your desk is sent, and nothing downloads or installs by itself. Off until you switch it on.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE895;"/>
        </tk:SettingsCard.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.CheckUpdatesAutomatically, Mode=TwoWay}" AutomationProperties.Name="CheckUpdatesAutomatically"/>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Repair"
                       Description="Puts back the sign-in task and the Start menu shortcut if something removed them, and restarts the engine. No setting changes.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE90F;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button x:Name="RepairButton" Content="Repair" Click="OnRepair" AutomationProperties.Name="Repair"/>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Clear logs and cached data"
                       Description="Logs, and what DispCtrl learned about your monitors, which it reads again by itself. Settings, presets and codes you named are kept.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE74D;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button Content="Clear" Click="OnClearCache" AutomationProperties.Name="ClearCache"/>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Undo the way back"
                       Description="Ctrl+Alt+Backspace switches off everything that can darken, tint or hide a screen. This switches back on what it last turned off: taskbar hiding and dimming on each monitor, night light, focus, OLED care and taskbar opacity.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7A7;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button Content="Put back" Click="OnUndoRestore" AutomationProperties.Name="UndoRestore"/>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Reset everything"
                       Description="Returns all of DispCtrl's settings, every monitor's and the shortcuts, to their defaults. Windows' own display settings are left alone.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE777;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button Content="Reset all" Click="OnResetAll" AutomationProperties.Name="ResetAll"/>
      </tk:SettingsCard>

    </StackPanel>
  </ScrollViewer>
</Page>
