<Page x:Class="DispCtrl.App.Views.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="0" HorizontalAlignment="Stretch">
      <TextBlock Text="Help" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="Quick answers, troubleshooting and ways to contribute."
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,28"/>

      <TextBlock Text="Project" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
      <tk:SettingsCard Header="Source code" Description="Read the code, documentation and current work on GitHub.">
        <Button Content="Open GitHub" Click="OnSource"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Report a problem or request a feature" Description="Open an issue with what happened and what you expected.">
        <Button Content="Open issue" Click="OnIssue"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Contribute code" Description="Compare a branch or fork and open a pull request.">
        <Button Content="Open pull request" Click="OnPullRequest"/>
      </tk:SettingsCard>

      <TextBlock Text="Common help" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,8"/>
      <tk:SettingsExpander Header="A taskbar is stuck off-screen" Description="Restart Windows Explorer to restore it after a forced engine exit.">
        <tk:SettingsExpander.Items>
          <tk:SettingsCard ContentAlignment="Left">
            <TextBlock Text="Open Task Manager, select Windows Explorer, then choose Restart. Stopping the engine normally restores managed taskbars first." TextWrapping="Wrap"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>
      <tk:SettingsExpander Header="The primary taskbar will not hide" Description="Explorer restores the primary taskbar when another process moves it.">
        <tk:SettingsExpander.Items>
          <tk:SettingsCard ContentAlignment="Left">
            <TextBlock Text="Use Windows auto-hide, or make another display primary. Per-display hiding is intended for secondary taskbars." TextWrapping="Wrap"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>
      <tk:SettingsExpander Header="A monitor forgot its settings" Description="Settings follow the monitor identity reported by its hardware.">
        <tk:SettingsExpander.Items>
          <tk:SettingsCard ContentAlignment="Left">
            <TextBlock Text="A panel without a serial number may look new after moving to another port. Reconnect it to the original port or configure it again." TextWrapping="Wrap"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>
    </StackPanel>
  </ScrollViewer>
</Page>
