<Page x:Class="DispCtrl.App.Views.DisplaysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:vm="using:DispCtrl.App.ViewModels"
      xmlns:views="using:DispCtrl.App.Views"
      Loaded="OnLoaded">

  <Page.Resources>
    <!-- One style per kind of cell in the information table, so the block reads
         as a table rather than as a pile of individually styled text.

         Top aligned rather than centred: a value long enough to wrap used to
         pull its own label down into the middle of the two lines, which is what
         made a column of otherwise tidy pairs look ragged. -->
    <Style x:Key="InfoSection" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,12,0,2"/>
    </Style>
    <Style x:Key="InfoLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="InfoValue" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="IsTextSelectionEnabled" Value="True"/>
    </Style>
    <!-- Serials, device names and identity tokens: monospaced because they are
         read a character at a time, and dimmed because they only matter when
         something has gone wrong. -->
    <Style x:Key="InfoIdentifier" TargetType="TextBlock"
           BasedOn="{StaticResource InfoValue}">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

  <ScrollViewer Grid.Row="0" Padding="0,0,0,32">
    <!-- Stretch with no MaxWidth. The cap was the problem: a Stretch panel
           with a MaxWidth centres itself once the window exceeds that width,
           which is what pushed content off to one side. Pinning it Left instead
           fixed the drift but made the panel size to its content, so cards
           stopped filling. Filling at every width is what Windows Settings
           does, and the side padding already keeps line length sane. -->
      <StackPanel Padding="36,12,36,0" Spacing="0"
                  HorizontalAlignment="Stretch">

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Displays" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="{x:Bind ViewModel.TopologyText, Mode=OneWay}"
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Button Grid.Column="1" Click="OnRescan"
                VerticalAlignment="Bottom" Width="40" Height="36" Padding="0"
                ToolTipService.ToolTip="Rescan displays"
                AutomationProperties.Name="Rescan displays">
          <FontIcon Glyph="&#xE72C;" FontSize="16"/>
        </Button>
      </Grid>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
               Visibility="{x:Bind ViewModel.InactiveVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.InactiveText, Mode=OneWay}"/>

      <!-- The arrangement leads the page. It is the picture of the desk, and
           everything below it is a setting belonging to one of the panels in
           that picture, so it reads as the subject rather than as one more card
           among the settings. Detect, Identify, Reset and Apply all live inside
           the surface, because each of them is about the diagram.

           Deliberately not a SettingsCard. That control reserves a header
           gutter and places content in its right-hand action area whatever
           ContentAlignment says, so a wide child ends up stranded in a narrow
           column — glaring once the window is maximised. A plain header plus a
           full-width block is what actually spans. -->
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <FontIcon Glyph="&#xE80A;" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Arrange displays"/>
            <TextBlock Text="Drag a display to match where it physically sits. Nothing changes until you apply."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>
        <views:ArrangeCanvas x:Name="ArrangeSurface" Margin="0,4,0,4"/>
      </StackPanel>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,4"
               Visibility="{x:Bind ViewModel.DetectStatusVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.DetectStatus, Mode=OneWay}"/>

      <!-- The same four choices as Win+P, applied through the documented
           topology flags so Windows reuses the arrangement you last had. -->
      <tk:SettingsCard Header="Multiple displays"
                       Description="How the desktop is spread across your monitors.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7F4;"/>
        </tk:SettingsCard.HeaderIcon>
        <ComboBox ItemsSource="{x:Bind ViewModel.Arrangements}"
                  SelectedItem="{x:Bind ViewModel.SelectedArrangement, Mode=TwoWay}"
                  MinWidth="240"/>
      </tk:SettingsCard>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Margin="0,4,0,0"
               Visibility="{x:Bind ViewModel.ArrangementStatusVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.ArrangementStatus, Mode=OneWay}"/>

      <!-- The device library has its own page: every monitor seen, mapping the
           codes nobody has named, and sharing one model at a time. -->
      <tk:SettingsCard Header="Monitor library"
                       Description="Every monitor this PC has seen, what each of its controls does, and sharing that with the project so the same model works for everyone."
                       IsClickEnabled="True" Click="OnOpenDevices"
                       AutomationProperties.Name="OpenDevicesPage">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE9F9;"/>
        </tk:SettingsCard.HeaderIcon>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Connect to a wireless display"
                       Description="Opens Windows' own pairing flow — Miracast discovery and PIN entry belong there.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7F7;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button Content="Connect" Click="OnConnectWireless"/>
      </tk:SettingsCard>

      <tk:SettingsExpander Header="Unison brightness"
                           Description="One control for every display, relative to the level each is already at."
                           Margin="0,4,0,0">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE706;"/>
        </tk:SettingsExpander.HeaderIcon>

        <!-- The slider sits on the header row, not only inside the expander.
             It is the control that gets reached for daily; making it cost an
             expand every time is the difference between a feature you use and
             one you remember exists. -->
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Slider Value="{x:Bind ViewModel.UnisonLevel, Mode=TwoWay}"
                  Minimum="{x:Bind ViewModel.UnisonMinimum, Mode=OneWay}"
                  Maximum="100" StepFrequency="1"
                  IsEnabled="{x:Bind ViewModel.UnisonSliderEnabled, Mode=OneWay}"
                  Width="200" VerticalAlignment="Center"
                  Visibility="{x:Bind ViewModel.UnisonVisibility, Mode=OneWay}"
                  AutomationProperties.Name="UnisonLevelSliderInline"/>
          <TextBlock Text="{x:Bind ViewModel.UnisonPercentText, Mode=OneWay}"
                     VerticalAlignment="Center" MinWidth="40"
                     Visibility="{x:Bind ViewModel.UnisonVisibility, Mode=OneWay}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <ToggleSwitch IsOn="{x:Bind ViewModel.UnisonBrightness, Mode=TwoWay}"
                        AutomationProperties.Name="UnisonBrightnessToggle"/>
        </StackPanel>

        <tk:SettingsExpander.Items>
          <!-- First, because it changes what unison is: from a slider in this
               app to the brightness control every Windows user already reaches
               for. The engine does the following, so it works with the app shut. -->
          <tk:SettingsCard Header="Replace Windows brightness"
                           Description="{x:Bind ViewModel.UnisonFollowsWindowsDescription, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE793;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.UnisonFollowsWindows, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.UnisonFollowsWindowsAvailable, Mode=OneWay}"
                          AutomationProperties.Name="UnisonFollowsWindows"/>
          </tk:SettingsCard>

          <!-- Calibration is a walkthrough rather than two number boxes: the
               limits are a judgement made by looking at the panels side by
               side, which no amount of typing reproduces. -->
          <tk:SettingsCard Header="Use captured limits"
                           Description="Choose how dim and bright each display should go, then run the slider between those limits.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE9E9;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.UnisonCalibrated, Mode=TwoWay}"
                          AutomationProperties.Name="UnisonCalibratedToggle"/>
          </tk:SettingsCard>

          <tk:SettingsCard Header="{x:Bind ViewModel.CalibrationHeader, Mode=OneWay}"
                           Description="{x:Bind ViewModel.CalibrationPrompt, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.CalibrationStepVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{x:Bind ViewModel.CalibrationButtonText, Mode=OneWay}"
                      Style="{StaticResource AccentButtonStyle}"
                      Click="OnCaptureLimits"
                      AutomationProperties.Name="CaptureLimitButton"/>
              <Button Content="Cancel" Click="OnCancelCalibration"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Captured limits"
                           Description="{x:Bind ViewModel.CalibrationSummary, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.RecalibrateVisibility, Mode=OneWay}">
            <Button Content="Calibrate again" Click="OnRecalibrate"
                    AutomationProperties.Name="RecalibrateButton"/>
          </tk:SettingsCard>

          <!-- The slider is a multiplier, so its own number says nothing about
               where any given panel ended up. This does. -->
          <tk:SettingsCard Header="Each display now"
                           Description="{x:Bind ViewModel.BrightnessSummary, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7F4;"/>
            </tk:SettingsCard.HeaderIcon>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <tk:SettingsExpander Header="Night light"
                           Description="Warmer colours on every display at once, to cut blue light in the evening."
                           Margin="0,4,0,0">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE706;"/>
        </tk:SettingsExpander.HeaderIcon>

        <!-- Just the switch out here, unlike unison above. Night light is set
             once and left; the strength belongs inside with the rest of its
             settings rather than taking a second copy of itself onto the
             header row. -->
        <ToggleSwitch IsOn="{x:Bind ViewModel.NightLightEnabled, Mode=TwoWay}"
                      AutomationProperties.Name="NightLightToggle"/>

        <tk:SettingsExpander.Items>
          <!-- Windows has a night light of its own, and two switches for one
               screen is a worse answer than one switch that both pages show.
               With this on, Windows does the warming: a display has one gamma
               ramp, and both warming it at once is twice as orange as either
               asked for. -->
          <tk:SettingsCard Header="Use Windows' night light"
                           Description="Makes this and Windows' own night light the same switch, in both directions. Windows then does the warming, reaching 1200K but only for the whole desk at once.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE771;"/>
            </tk:SettingsCard.HeaderIcon>
            <!-- The button stays regardless of the switch: Windows' page holds
                 the parts deliberately not mirrored here, its own schedule and
                 the sunset-to-sunrise option, which are worth reaching whether
                 or not the two toggles are linked. -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Click="OnOpenWindowsNightLight"
                      ToolTipService.ToolTip="Opens Windows' own night light page in Settings"
                      AutomationProperties.Name="OpenWindowsNightLight">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                  <TextBlock Text="Open in Windows"/>
                </StackPanel>
              </Button>
              <ToggleSwitch IsOn="{x:Bind ViewModel.NightLightFollowsWindows, Mode=TwoWay}"
                            AutomationProperties.Name="NightLightFollowWindowsToggle"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Strength"
                           Description="{x:Bind ViewModel.NightLightStrengthDetail, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.NightLightSharedVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Slider Value="{x:Bind ViewModel.NightLightStrength, Mode=TwoWay}"
                      Minimum="5" Maximum="100" StepFrequency="1"
                      Width="240" VerticalAlignment="Center"
                      AutomationProperties.Name="NightLightStrengthSlider"/>
              <TextBlock Text="{x:Bind ViewModel.NightLightStrengthText, Mode=OneWay}"
                         VerticalAlignment="Center" MinWidth="96"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Schedule"
                           Description="Leave off to keep the warmth on until you switch it off."
                           Visibility="{x:Bind ViewModel.NightLightVisibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE823;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.NightLightScheduled, Mode=TwoWay}"
                          AutomationProperties.Name="NightLightScheduleToggle"/>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Hours"
                           Description="A window that runs past midnight is normal and handled."
                           Visibility="{x:Bind ViewModel.NightLightScheduleVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TimePicker Time="{x:Bind ViewModel.NightLightFrom, Mode=TwoWay}"
                          ClockIdentifier="24HourClock"
                          AutomationProperties.Name="NightLightFrom"/>
              <TextBlock Text="to" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TimePicker Time="{x:Bind ViewModel.NightLightTo, Mode=TwoWay}"
                          ClockIdentifier="24HourClock"
                          AutomationProperties.Name="NightLightTo"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Gamma range"
                           Description="{x:Bind ViewModel.GammaRangeDetail, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7B3;"/>
            </tk:SettingsCard.HeaderIcon>
            <Button Content="{x:Bind ViewModel.GammaRangeButtonText, Mode=OneWay}"
                    Click="OnToggleGammaRange"
                    AutomationProperties.Name="ToggleGammaRange"/>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Right now"
                           Description="{x:Bind ViewModel.NightLightStatus, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE9E9;"/>
            </tk:SettingsCard.HeaderIcon>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <!-- Dark mode, focus and OLED rest sit with unison brightness and night
           light because they are the same kind of setting: one switch for the
           whole desk. They were on the Settings page, which left the page about
           DispCtrl itself holding most of what DispCtrl does to the displays. -->
      <tk:SettingsCard Header="Dark mode"
                       Description="Windows&#39; own setting, for apps and the taskbar together. DispCtrl follows it like any other app."
                       Margin="0,4,0,0">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE708;"/>
        </tk:SettingsCard.HeaderIcon>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnOpenWindowsColours"
                  ToolTipService.ToolTip="Opens Windows&#39; own colours page in Settings"
                  AutomationProperties.Name="OpenWindowsColours">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
              <TextBlock Text="Open in Windows"/>
            </StackPanel>
          </Button>
          <ToggleSwitch IsOn="{x:Bind ViewModel.DarkMode, Mode=TwoWay}"
                        AutomationProperties.Name="DarkModeToggle"/>
        </StackPanel>
      </tk:SettingsCard>

      <tk:SettingsExpander Header="Focus mode"
                           Description="Keep the active window clear and dim its surroundings. Applies to windows, not to individual browser tabs."
                           Margin="0,4,0,0">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE890;"/>
        </tk:SettingsExpander.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.FocusEnabled, Mode=TwoWay}" AutomationProperties.Name="FocusMode"/>
        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="Background dimming" Description="0% is unchanged; 100% is black. The active window stays at its normal brightness.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.FocusDim, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" Width="160" AutomationProperties.Name="FocusDim"/>
              <TextBlock Text="{x:Bind ViewModel.FocusDim, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Delay after switching windows" Description="Milliseconds before the background starts to dim.">
            <NumberBox Value="{x:Bind ViewModel.FocusDelay, Mode=TwoWay}" Minimum="0" Maximum="10000" SmallChange="100" Width="135" SpinButtonPlacementMode="Compact" AutomationProperties.Name="FocusDelay"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Fade duration" Description="Milliseconds, for the dimming appearing and disappearing and for the slide below. Set to 0 for an instant change.">
            <NumberBox Value="{x:Bind ViewModel.FocusFade, Mode=TwoWay}" Minimum="0" Maximum="2000" SmallChange="50" Width="135" SpinButtonPlacementMode="Compact" AutomationProperties.Name="FocusFade"/>
          </tk:SettingsCard>
          <!-- One choice, not two switches. Both at once meant the shape
               travelled and cross-faded together, which is the worst of the
               pair rather than a blend of them. -->
          <tk:SettingsCard Header="Transition between windows"
                           Description="Fading moves only the brightness and cuts both shapes instantly. Sliding moves the shape across, which is what reads as lag.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE706;"/>
            </tk:SettingsCard.HeaderIcon>
            <ComboBox ItemsSource="{x:Bind ViewModel.WindowTransitions}"
                      SelectedIndex="{x:Bind ViewModel.WindowTransition, Mode=TwoWay}"
                      MinWidth="200"
                      AutomationProperties.Name="WindowTransition"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="One clear window per display"
                           Description="Each display keeps the last window used on it clear, instead of the whole desk sharing one. A display nothing has been opened on stays dimmed.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7F4;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusPerMonitor, Mode=TwoWay}" AutomationProperties.Name="FocusPerMonitor"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Keep the hovered window clear too"
                           Description="Hold both the focused window and the one under the pointer clear at once, for reading one while typing in another. The taskbar counts as a window, so pointing at it clears it too.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE962;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusKeepHoveredClear, Mode=TwoWay}" AutomationProperties.Name="FocusKeepHoveredClear"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="OLED displays only" Description="Dim only the panels marked as OLED under Each display, below.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusOledOnly, Mode=TwoWay}" AutomationProperties.Name="FocusOledOnly"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Match the dimming to brightness"
                           Description="Ease the dimming on panels unison brightness is already running dim, so one setting looks the same on every screen.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE706;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusScaleWithBrightness, Mode=TwoWay}" AutomationProperties.Name="FocusScaleWithBrightness"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Follow the mouse"
                           Description="Keep whatever the pointer is over clear, rather than the window with keyboard focus.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE962;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusFollowMouse, Mode=TwoWay}" AutomationProperties.Name="FocusFollowMouse"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Follow new and activated windows"
                           Description="Temporarily keep an app opened or activated by a launcher, script or automation clear. Moving the pointer returns control to mouse following.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE8A7;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusPrioritizeNewWindows, Mode=TwoWay}"
                          AutomationProperties.Name="FocusPrioritizeNewWindows"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Dim other monitors"
                           Description="Also dim monitors that do not contain the active window. Ignored when each display keeps its own window, since then every display has one. Which displays may be dimmed at all is set on each display, below.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusOtherMonitors, Mode=TwoWay}" AutomationProperties.Name="FocusOtherMonitors"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Keep taskbar area clear" Description="Leave the space reserved for the taskbar at normal brightness.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusKeepTaskbar, Mode=TwoWay}" AutomationProperties.Name="FocusKeepTaskbar"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Pause for fullscreen windows" Description="Avoid dimming while watching fullscreen content or playing a fullscreen game.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusPauseFullscreen, Mode=TwoWay}" AutomationProperties.Name="FocusPauseFullscreen"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Excluded apps" Description="Pause while one of these apps is active. Separate executable names with commas, for example vlc.exe, game.exe." ContentAlignment="Vertical">
            <TextBox Text="{x:Bind ViewModel.FocusExcludedApps, Mode=TwoWay}" PlaceholderText="App executable names" AutomationProperties.Name="FocusExcludedApps"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Right now" Description="{x:Bind ViewModel.ProtectionStatus, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE9E9;"/>
            </tk:SettingsCard.HeaderIcon>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Reset focus mode"
                           Description="Puts the settings above back to their defaults. The switch itself is left alone.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE777;"/>
            </tk:SettingsCard.HeaderIcon>
            <Button Content="Reset" Click="OnResetFocus" AutomationProperties.Name="ResetFocusSettings"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <!-- One switch, but it reaches only the panels that are both marked OLED
           and have protection left on, so the first card says which those are.
           A global-looking toggle that quietly skips half the desk is the kind
           of control someone has to test to understand. -->
      <tk:SettingsExpander Header="OLED idle protection"
                           Description="Rest OLED panels after a spell without input. Panels not marked as OLED are never touched."
                           Margin="0,4,0,0">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE7F4;"/>
        </tk:SettingsExpander.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.OledIdleEnabled, Mode=TwoWay}" AutomationProperties.Name="OledIdleProtection"/>
        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="Which displays" Description="{x:Bind ViewModel.OledCoverage, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7F4;"/>
            </tk:SettingsCard.HeaderIcon>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Dim after inactivity" Description="Minutes without keyboard or mouse input. Input restores the display automatically.">
            <NumberBox Value="{x:Bind ViewModel.OledIdleMinutes, Mode=TwoWay}" Minimum="1" Maximum="120" SmallChange="1" Width="135" SpinButtonPlacementMode="Compact" AutomationProperties.Name="OledIdleMinutes"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Idle dimming" Description="With protection enabled, changes preview for two seconds. 100% is black; this does not run a hardware compensation cycle.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.OledIdleDim, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" Width="160" AutomationProperties.Name="OledIdleDim"/>
              <TextBlock Text="{x:Bind ViewModel.OledIdleDim, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Second-stage dimming"
                           Description="After the first dim, reduce the panel again. Available when the first level is between 1% and 99%."
                           Visibility="{x:Bind ViewModel.OledSecondStageVisibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledSecondStageEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="OledSecondStageEnabled"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Second stage after"
                           Description="Additional minutes spent at the first dimming level."
                           Visibility="{x:Bind ViewModel.OledSecondStageVisibility, Mode=OneWay}">
            <NumberBox Value="{x:Bind ViewModel.OledSecondStageMinutes, Mode=TwoWay}"
                       Minimum="1" Maximum="120" SmallChange="1" Width="135"
                       IsEnabled="{x:Bind ViewModel.OledSecondStageEnabled, Mode=OneWay}"
                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="OledSecondStageMinutes"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Second-stage dimming level"
                           Description="The final dimming level; it cannot be lighter than the first stage."
                           Visibility="{x:Bind ViewModel.OledSecondStageVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.OledSecondStageDim, Mode=TwoWay}"
                      Minimum="{x:Bind ViewModel.OledIdleDim, Mode=OneWay}" Maximum="100" StepFrequency="5" Width="160"
                      IsEnabled="{x:Bind ViewModel.OledSecondStageEnabled, Mode=OneWay}"
                      AutomationProperties.Name="OledSecondStageDim"/>
              <TextBlock Text="{x:Bind ViewModel.OledSecondStageDim, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Idle fade duration" Description="Milliseconds to reach the idle dimming level.">
            <NumberBox Value="{x:Bind ViewModel.OledIdleFade, Mode=TwoWay}" Minimum="0" Maximum="2000" SmallChange="100" Width="135" SpinButtonPlacementMode="Compact" AutomationProperties.Name="OledIdleFade"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Pause during fullscreen content">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledPauseFullscreen, Mode=TwoWay}" AutomationProperties.Name="OledPauseFullscreen"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Reset OLED idle protection"
                           Description="Puts the settings above back to their defaults. Which panels are OLED is set on each display.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE777;"/>
            </tk:SettingsCard.HeaderIcon>
            <Button Content="Reset" Click="OnResetOled" AutomationProperties.Name="ResetOledSettings"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <tk:SettingsExpander Header="Keep awake"
                           Description="Temporarily prevent system sleep without changing the selected Windows power plan."
                           Margin="0,4,0,0">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE916;"/>
        </tk:SettingsExpander.HeaderIcon>
        <Button Content="Reset" Click="OnResetAwake" AutomationProperties.Name="ResetAwakeSettings"/>
        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="Mode" Description="Choose when the engine should hold a Windows power request.">
            <ComboBox ItemsSource="{x:Bind ViewModel.AwakeModes}"
                      SelectedIndex="{x:Bind ViewModel.AwakeModeIndex, Mode=TwoWay}"
                      MinWidth="240" AutomationProperties.Name="AwakeMode"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Time interval" Description="Changing this restarts the interval."
                           Visibility="{x:Bind ViewModel.AwakeTimedVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <NumberBox Value="{x:Bind ViewModel.AwakeHours, Mode=TwoWay}" Minimum="0" Maximum="168" Width="105" Header="Hours" SpinButtonPlacementMode="Compact"/>
              <NumberBox Value="{x:Bind ViewModel.AwakeMinutes, Mode=TwoWay}" Minimum="0" Maximum="59" Width="105" Header="Minutes" SpinButtonPlacementMode="Compact"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Expiration" Description="Return to the selected power plan at this local date and time."
                           Visibility="{x:Bind ViewModel.AwakeExpirationVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <DatePicker Date="{x:Bind ViewModel.AwakeExpirationDate, Mode=TwoWay}"/>
              <TimePicker Time="{x:Bind ViewModel.AwakeExpirationTime, Mode=TwoWay}"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Keep displays on"
                           Description="Also prevent display timeout while keep-awake is active. Manual sleep commands still work.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.AwakeKeepDisplaysOn, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.AwakeOptionsEnabled, Mode=OneWay}"
                          AutomationProperties.Name="AwakeKeepDisplaysOn"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Right now" Description="{x:Bind ViewModel.AwakeStatus, Mode=OneWay}"/>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <TextBlock Text="Each display"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <!-- Deliberately ItemsControl, not ItemsRepeater. ItemsRepeater
           virtualises: expanding a card near the bottom grew the extent, which
           scrolled the card out of the realisation window, which recycled the
           element and collapsed it, which shrank the extent again — a visible
           open/close flicker that fed itself. There are two or three displays
           here; there is nothing to virtualise, and realising them all also
           means the hardware reads start immediately instead of when a card
           first scrolls into view. -->
      <ItemsControl ItemsSource="{x:Bind ViewModel.Displays, Mode=OneWay}"
                    HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DisplayViewModel">

            <tk:SettingsExpander Header="{x:Bind Name}" Description="{x:Bind Details}">
              <tk:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE7F4;"/>
              </tk:SettingsExpander.HeaderIcon>

              <TextBlock Text="{x:Bind SummaryLine, Mode=OneWay}"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

              <tk:SettingsExpander.Items>

                <!-- Information first: the panel on the left, and everything it
                     reports in one block pinned to the right edge.

                     Pinned rather than spread across the card, because that is
                     the grammar of every other row on this page — what the
                     thing is on the left, what it says or does on the right.
                     Left to fill the width, the table put its labels hard
                     against the icon gutter and its values adrift in the middle
                     of an otherwise empty row, lining up with nothing above or
                     below it.

                     SettingsCard keeps its icon/header gutter even with
                     ContentAlignment="Vertical", so content is always indented
                     past it. Rather than fight that, the card is given a real
                     header: the content then aligns under the header text,
                     which is how Windows Settings lays out an expanded card —
                     deliberate rather than a gap. -->
                <tk:SettingsCard ContentAlignment="Vertical"
                                 HorizontalContentAlignment="Stretch">
                  <Grid ColumnSpacing="24" RowSpacing="16" Padding="0,4,0,8"
                        SizeChanged="OnDisplayOverviewSizeChanged" RowDefinitions="Auto,Auto">
                    <Grid.ColumnDefinitions>
                      <!-- The preview takes whatever the table does not, and
                           centres itself in it. Pinned left it sat alone against
                           the icon gutter with the whole gap to its right; in
                           the middle of its own share it reads as the other half
                           of the card rather than as something left over. -->
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The panel itself, drawn at its real aspect ratio with
                         its own wallpaper in it — the same idea as the preview
                         in Windows' Display settings. -->
                    <!-- Centred on both axes, so it sits in the middle of the
                         space between the card edge and the table beside it. -->
                    <Viewbox Grid.Column="1" MaxWidth="340" Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                      <Border Width="{x:Bind PreviewWidth}"
                              Height="{x:Bind PreviewHeight}"
                              HorizontalAlignment="Center"
                              CornerRadius="6"
                              BorderThickness="2"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <Grid>
                          <Image Source="{x:Bind WallpaperImage, Mode=OneWay}"
                                 Stretch="UniformToFill"
                                 Visibility="{x:Bind HasWallpaper, Mode=OneWay}"/>
                          <!-- A dark wallpaper left the tile looking like an
                               empty box; the scrim keeps the number legible
                               whatever is behind it. The number itself sits
                               straight on the panel with no chip, which is how
                               Windows draws it — the chip was the detail that
                               made this read as an imitation of the real one. -->
                          <Border Background="#59000000"/>
                          <TextBlock Text="{x:Bind Number}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontSize="48" FontWeight="SemiBold"
                                     Foreground="White"/>
                        </Grid>
                      </Border>

                      <TextBlock Text="{x:Bind PreviewCaption}"
                                 HorizontalAlignment="Center"
                                 Style="{StaticResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    </Viewbox>

                    <!-- Everything the display says, as one block against the
                         right edge. Capped rather than stretched: a table that
                         grows with the window ends up with a hand's width of
                         nothing between each label and its value. -->
                    <Grid Grid.Column="0" RowSpacing="8"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          MaxWidth="660">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>

                      <!-- The whole table, in one press, and attached to the
                           block it copies. Every value below is selectable, but
                           dragging a selection through thirty rows of a
                           scrolling list is not what someone should have to do
                           to paste their monitor into a support thread. -->
                      <!-- On the caption's line, not a row of its own: alone,
                           it opened a gap above the table that belonged to
                           nothing. Drawn after the table, so it sits on top. -->
                      <Button Grid.Row="1" Canvas.ZIndex="1" Click="OnCopyInfo" Tag="{x:Bind}"
                              Width="40" Height="36" Padding="0"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,-8,0,0"
                              ToolTipService.ToolTip="Copy these details"
                              AutomationProperties.Name="{x:Bind CopyInfoAutomationName}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                      </Button>

                      <!-- Scrolled, with a ceiling. This is thirty-odd rows and
                           it is the first thing an expanded card shows: at full
                           height it pushed every actual control for the display
                           past the bottom of the window, so the table had to be
                           scrolled past rather than read. Chaining is left on,
                           so the wheel carries on down the page once the table
                           is at its end. -->
                      <ScrollViewer Grid.Row="1"
                                    MaxHeight="360"
                                    Padding="0,0,12,0"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled">
                        <!-- ItemsControl, not ItemsRepeater: the same
                             virtualisation trap as the display list above, and
                             there is nothing here worth virtualising. -->
                        <ItemsControl ItemsSource="{x:Bind Information, Mode=OneWay}"
                                      HorizontalContentAlignment="Stretch">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoRow">
                              <!-- One fixed label column for every row, which is
                                   what makes the values line up. Sized per row,
                                   each pair found its own width and the column
                                   of values came out ragged. -->
                              <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="190"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{x:Bind Label}"
                                           Visibility="{x:Bind SectionVisibility}"
                                           Style="{StaticResource InfoSection}"/>

                                <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                           Visibility="{x:Bind FieldVisibility}"
                                           Style="{StaticResource InfoLabel}"/>

                                <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                           Visibility="{x:Bind ProseVisibility}"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                           Visibility="{x:Bind IdentifierVisibility}"
                                           Style="{StaticResource InfoIdentifier}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </Grid>
                </tk:SettingsCard>

                <!-- Then wallpaper, then brightness, then the rest. -->
                <tk:SettingsCard Header="Wallpaper" Description="{x:Bind WallpaperName, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Change…" Click="OnPickWallpaper" Tag="{x:Bind}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Fit"
                                 Description="How the image is scaled to the screen. Windows applies the fit mode to every display.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9A6;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind WallpaperFits}"
                            SelectedItem="{x:Bind SelectedWallpaperFit, Mode=TwoWay}"
                            MinWidth="140"/>
                </tk:SettingsCard>

                <!-- Wrapped in a card, not placed bare. SettingsExpander.Items
                     only accepts card-like children; a raw InfoBar here takes
                     the process down when the expander realises its content. -->
                <tk:SettingsCard ContentAlignment="Vertical"
                                 Visibility="{x:Bind SystemWideWallpaperNotice}">
                  <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                           HorizontalAlignment="Stretch" Margin="0,0,0,8"
                           Message="Per-monitor wallpaper is unavailable on this machine — the IDesktopWallpaper COM class has no registered server, so a change here applies to every display."/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Brightness" Description="{x:Bind BrightnessBackend}"
                                 Visibility="{x:Bind BrightnessVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Named per display: two identically-labelled sliders on
                         one page are indistinguishable to a screen reader. -->
                    <Slider Value="{x:Bind BrightnessPercent, Mode=TwoWay}"
                            Minimum="0" Maximum="100" StepFrequency="1"
                            Width="220" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind BrightnessAutomationName}"/>
                    <TextBlock Text="{x:Bind BrightnessPercent, Mode=OneWay}"
                               VerticalAlignment="Center" MinWidth="32"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </tk:SettingsCard>

                <!-- Only where the real thing is missing. On a panel with a
                     reachable backlight this would be strictly worse: the same
                     light, less contrast. -->
                <tk:SettingsCard Header="Software brightness"
                                 Description="{x:Bind SoftwareBrightnessDescription, Mode=OneWay}"
                                 Visibility="{x:Bind SoftwareBrightnessVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider Value="{x:Bind SoftwareBrightness, Mode=TwoWay}"
                            Minimum="{x:Bind SoftwareBrightnessMinimum, Mode=OneWay}"
                            Maximum="100" StepFrequency="1"
                            Width="220" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind SoftwareBrightnessAutomationName}"/>
                    <TextBlock Text="{x:Bind SoftwareBrightnessText, Mode=OneWay}"
                               VerticalAlignment="Center" MinWidth="40"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Brightness"
                                 Description="This display does not report brightness control."
                                 Visibility="{x:Bind NoBrightnessVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Unavailable" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Night light"
                                 Description="{x:Bind NightLightStrengthText, Mode=OneWay}"
                                 Visibility="{x:Bind NightLightVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Slider Value="{x:Bind NightLightStrength, Mode=TwoWay}"
                          Minimum="5" Maximum="100" StepFrequency="1"
                          Width="220" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Bind WarmthAutomationName}"/>
                </tk:SettingsCard>

                <!-- Windows settings, not the monitor's, but they act on this
                     panel and nothing else: the light sensor drives the
                     built-in backlight and the accelerometer turns the built-in
                     screen. They belong where someone would look for them. -->
                <tk:SettingsCard Header="Adaptive brightness"
                                 Description="{x:Bind AdaptiveDetail, Mode=OneWay}"
                                 Visibility="{x:Bind AdaptiveVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind AdaptiveOn, Mode=TwoWay}"
                                AutomationProperties.Name="AdaptiveBrightnessToggle"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Rotate with the device"
                                 Description="{x:Bind RotationDetail, Mode=OneWay}"
                                 Visibility="{x:Bind RotationVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7AD;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind RotationOn, Mode=TwoWay}"
                                AutomationProperties.Name="AutoRotationToggle"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="OLED panel"
                                 Description="{x:Bind OledSummary, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind IsOled, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind OledAutomationName}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Focus dimming"
                                 Description="Let focus mode dim this display. Off leaves it at full brightness whatever else is happening.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE890;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind FocusDimming, Mode=TwoWay}" AutomationProperties.Name="{x:Bind FocusDimmingAutomationName}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="OLED burn-in protection"
                                 Description="Whether the shared idle and screen-rest settings above reach this panel."
                                 Visibility="{x:Bind OledProtectionVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Run screen rest" Click="OnScreenRest" Tag="{x:Bind}"
                            ToolTipService.ToolTip="Blacks this panel now. Move the mouse or press a key to end it early."
                            AutomationProperties.Name="RunOledScreenRest"/>
                    <NumberBox Value="{x:Bind OledRestMinutes, Mode=TwoWay}"
                               Minimum="1" Maximum="30" SmallChange="1" Width="92"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="OledRestMinutes"/>
                    <TextBlock Text="minutes" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch IsOn="{x:Bind OledProtectionEnabled, Mode=TwoWay}" AutomationProperties.Name="OledPanelProtection"/>
                  </StackPanel>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Wake when the pointer returns"
                                 Description="After idle dimming starts, activity on other screens keeps this panel dimmed. Move the pointer onto or within this screen to restore it. The second dimming stage continues while you are away. Applies to idle protection, not manual screen rest."
                                 Visibility="{x:Bind OledProtectionVisibility, Mode=OneWay}">
                  <ToggleSwitch IsOn="{x:Bind OledWakeOnPointerReturn, Mode=TwoWay}"
                                IsEnabled="{x:Bind OledProtectionEnabled, Mode=OneWay}"
                                AutomationProperties.Name="OledWakeOnPointerReturn"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Monitor sleep"
                                 Description="{x:Bind MonitorPowerDescription, Mode=OneWay}"
                                 Visibility="{x:Bind MonitorPowerVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <NumberBox Value="{x:Bind MonitorSleepMinutes, Mode=TwoWay}"
                               Minimum="1" Maximum="240" SmallChange="1" Width="92"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="MonitorSleepMinutes"
                               IsEnabled="{x:Bind MonitorSleepEnabled, Mode=OneWay}"/>
                    <TextBlock Text="minutes idle" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch IsOn="{x:Bind MonitorSleepEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="MonitorSleepEnabled"/>
                  </StackPanel>
                </tk:SettingsCard>

                <tk:SettingsCard Header="HDR" Description="{x:Bind HdrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind HdrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind HdrEnabled, Mode=TwoWay}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="HDR" Description="{x:Bind HdrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind NoHdrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Not supported" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Scale"
                                 Description="Applies immediately. Some apps only pick up a scale change when restarted."
                                 Visibility="{x:Bind ScalingVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind ScalingOptions}"
                            SelectedItem="{x:Bind SelectedScaling, Mode=TwoWay}"
                            MinWidth="140"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Scale" Description="Windows did not report scaling steps for this display."
                                 Visibility="{x:Bind NoScalingVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="{x:Bind ScaleText}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Resolution"
                                 Description="Changing resolution forces a full mode switch, so the screen will blank briefly.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind Resolutions}"
                            SelectedItem="{x:Bind SelectedResolution, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Refresh rate"
                                 Description="Changing only the rate is submitted as a timing change, which most drivers apply without blanking.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind RefreshRates}"
                            SelectedItem="{x:Bind SelectedRefreshRate, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Variable refresh rate"
                                 Description="{x:Bind VrrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind VrrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind VrrEnabled, Mode=TwoWay}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Variable refresh rate"
                                 Description="{x:Bind VrrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind NoVrrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Not supported" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Orientation" Description="Rotating swaps the resolution automatically.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7AD;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind Orientations}"
                            SelectedItem="{x:Bind SelectedOrientation, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Colour profile" Description="{x:Bind ColorProfileName, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Manage…" Click="OnColorManagement"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Main display" Description="{x:Bind RoleAndConnection}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9CE;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Grid>
                    <Button Content="Make this my main display"
                            Click="OnMakePrimary" Tag="{x:Bind}"
                            Visibility="{x:Bind SetPrimaryVisibility, Mode=OneWay}"/>
                    <TextBlock Text="This is your main display"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind IsPrimaryVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </Grid>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Hide the taskbar" Description="{x:Bind HideTaskbarDescription}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Grid>
                    <ToggleSwitch IsOn="{x:Bind HideTaskbar, Mode=TwoWay}"
                                  Visibility="{x:Bind ToggleVisibility}"/>
                    <!-- The primary display gets Windows' own auto-hide here,
                         rather than a dead control and a pointer elsewhere. -->
                    <ToggleSwitch IsOn="{x:Bind PrimaryAutoHide, Mode=TwoWay}"
                                  Visibility="{x:Bind PrimaryNoteVisibility}"/>
                  </Grid>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Reclaim the work area"
                                 Description="Let maximised windows fill the whole display. The taskbar appears over them when revealed.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9A6;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind ReclaimWorkArea, Mode=TwoWay}"
                                IsEnabled="{x:Bind CanHideTaskbar}"/>
                </tk:SettingsCard>

                <!-- Discovered, not assumed: the list comes from the panel's
                     own capabilities string, so it is exactly what this monitor
                     has, and most of it is reachable nowhere in Windows.

                     Deliberately a SettingsCard and not a nested
                     SettingsExpander. SettingsExpander.Items accepts only
                     card-like children, and an expander inside one does not
                     fail to render — it takes the process down when the item is
                     realised. That has now cost this project two crashes. -->
                <tk:SettingsCard ContentAlignment="Vertical"
                                 HorizontalContentAlignment="Stretch"
                                 Header="The monitor's own controls"
                                 Description="{x:Bind MonitorControlsSummary, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9E9;"/>
                  </tk:SettingsCard.HeaderIcon>

                  <ItemsControl ItemsSource="{x:Bind MonitorControls}"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,4,0,8"
                                Visibility="{x:Bind MonitorControlsVisibility, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="2"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MonitorControlViewModel">
                        <Grid ColumnSpacing="16" Padding="0,6,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}"/>
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1" Orientation="Horizontal"
                                      Spacing="12" VerticalAlignment="Center">
                            <Slider Value="{x:Bind Value, Mode=TwoWay}"
                                    Minimum="0" Maximum="{x:Bind Maximum}" StepFrequency="1"
                                    Width="200" VerticalAlignment="Center"
                                    Visibility="{x:Bind SliderVisibility}"
                                    AutomationProperties.Name="{x:Bind Code}"/>
                            <TextBlock Text="{x:Bind ValueText, Mode=OneWay}"
                                       VerticalAlignment="Center" MinWidth="32"
                                       Visibility="{x:Bind SliderVisibility}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind Options}"
                                      SelectedItem="{x:Bind Selected, Mode=TwoWay}"
                                      MinWidth="200"
                                      Visibility="{x:Bind ChoiceVisibility}"
                                      AutomationProperties.Name="{x:Bind Code}"/>
                            <TextBlock Text="{x:Bind ReadOnlyText}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ReadOnlyVisibility}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Also reported"
                                 Description="{x:Bind UnofferedSummary, Mode=OneWay}"
                                 Visibility="{x:Bind UnofferedVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;"/>
                  </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Reset this display"
                                 Description="Returns DispCtrl's own settings to their defaults. Resolution, refresh rate, HDR and scale belong to Windows and are left alone.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE777;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Reset" Click="OnResetDisplay" Tag="{x:Bind}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Visibility="{x:Bind ModeStatusVisibility, Mode=OneWay}"
                                 ContentAlignment="Vertical">
                  <TextBlock Text="{x:Bind ModeStatus, Mode=OneWay}"
                             Margin="0,0,0,8"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </tk:SettingsCard>

              </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

    <!-- Docked, not scrolled. A "you have unsaved changes, save or discard"
         prompt that scrolls off the top is one the user stops seeing exactly
         when it starts mattering, so it stays pinned to the bottom while the
         settings above it move. It drives the same view model as the Presets
         page, so the two cannot disagree. -->
    <Border x:Name="PresetFooter" x:Load="{x:Bind ViewModel.PresetsEnabled}" Grid.Row="1"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Padding="36,10,36,10">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- The picker's last entry starts a new preset, so creating one is
               reachable from the same control that switches between them. -->
          <ComboBox ItemsSource="{x:Bind ViewModel.Presets.Names}"
                    SelectedItem="{x:Bind ViewModel.Presets.Selected, Mode=TwoWay}"
                    MinWidth="170"
                    AutomationProperties.Name="StickyPresetPicker"/>

          <TextBox Text="{x:Bind ViewModel.Presets.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Name" MinWidth="170"
                   Visibility="{x:Bind ViewModel.Presets.CreatingVisibility, Mode=OneWay}"
                   AutomationProperties.Name="StickyPresetName"/>
        </StackPanel>

        <!-- The sign says everything the sentence did. "Saved" is what a bar
             reads for almost all of its life, which makes it a word that is
             always there and never tells you anything; the sign appears only
             when there is something to know, and opens the list when pressed. -->
        <views:PresetChanges Grid.Column="1" HorizontalAlignment="Left"
                             VerticalAlignment="Center"/>

        <!-- Nothing to do, nothing on screen. Buttons that are always there
             stop meaning anything, and applying a preset the desk already
             matches would blank the screen for a mode change that changes
             nothing. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Discard" Click="OnPresetDiscard"
                  ToolTipService.ToolTip="Put the displays back to this preset"
                  Visibility="{x:Bind ViewModel.Presets.ActionVisibility, Mode=OneWay}"
                  AutomationProperties.Name="StickyPresetDiscard"/>
          <Button Content="Save" Click="OnPresetSave"
                  Style="{StaticResource AccentButtonStyle}"
                  ToolTipService.ToolTip="Update this preset to match the displays"
                  Visibility="{x:Bind ViewModel.Presets.ActionVisibility, Mode=OneWay}"
                  AutomationProperties.Name="StickyPresetSave"/>
          <Button Content="Create" Click="OnPresetSave"
                  Style="{StaticResource AccentButtonStyle}"
                  Visibility="{x:Bind ViewModel.Presets.CreatingVisibility, Mode=OneWay}"
                  AutomationProperties.Name="StickyPresetCreate"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
