<Page x:Class="DispCtrl.App.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="0" HorizontalAlignment="Stretch">
      <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="DispCtrl — practical display control for Windows."
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,28"/>

      <tk:SettingsCard Header="Purpose"
                       Description="Manage displays, taskbars, colour and OLED protection from one lightweight open-source app."/>
      <tk:SettingsCard Header="Intent"
                       Description="Keep advanced display control local, understandable and efficient, without locking it behind a vendor utility."/>
      <tk:SettingsCard Header="Created by Jesvi Jonathan" Description="jesvi22j@gmail.com · www.jesvi.net">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Email" Click="OnEmail"/>
          <Button Content="jesvi.net" Click="OnWebsite"/>
          <Button Content="GitHub profile" Click="OnAuthorGitHub"/>
        </StackPanel>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Open source" Description="Inspect the source, follow development or contribute on GitHub.">
        <Button Content="View project" Click="OnRepository"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Support development"
                       Description="Help fund continued development and new display features.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xEB51;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button Click="OnSponsor"
                Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.Name="Donate through GitHub Sponsors">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="♥"/>
            <TextBlock Text="Donate" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>
      </tk:SettingsCard>

      <TextBlock Text="Build" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,8"/>
      <tk:SettingsCard Header="Version" Description="{x:Bind Version}"/>
      <tk:SettingsCard Header="Runtime" Description="{x:Bind Runtime}"/>
      <tk:SettingsCard Header="Windows" Description="{x:Bind OsVersion}"/>
      <tk:SettingsCard Header="Components" Description="Windows App SDK · Windows Community Toolkit · CsWin32"/>
    </StackPanel>
  </ScrollViewer>
</Page>
