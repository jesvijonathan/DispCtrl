<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DispCtrl.App.Views.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DispCtrl.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <!-- Rounded to match what DwmSetWindowAttribute rounds the window to. A
       square window behind a rounded border shows chopped corners, which is a
       trap this project has already paid for once. -->
  <Border x:Name="Root"
          CornerRadius="8"
          BorderThickness="1"
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Title row. Doubles as the drag handle: a flyout that cannot be moved
           is fine until it lands on the display being adjusted. -->
      <Grid x:Name="TitleRow" Grid.Row="0" Padding="16,12,8,8" ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="DispCtrl"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   VerticalAlignment="Center"/>

        <Button Grid.Column="1"
                x:Name="PinButton"
                Click="OnPin"
                Style="{StaticResource SubtleButtonStyle}"
                Width="36" Height="32" Padding="0"
                AutomationProperties.Name="QuickPanelPin"
                ToolTipService.ToolTip="Keep the panel open when it loses focus">
          <FontIcon x:Name="PinGlyph" FontSize="14" Glyph="&#xE718;"/>
        </Button>

        <Button Grid.Column="2"
                Click="OnOpenApp"
                Style="{StaticResource SubtleButtonStyle}"
                Width="36" Height="32" Padding="0"
                AutomationProperties.Name="QuickPanelSettings"
                ToolTipService.ToolTip="Open DispCtrl">
          <FontIcon FontSize="14" Glyph="&#xE713;"/>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1"
                    x:Name="Scroller"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,0,4">
        <StackPanel x:Name="Sections" Padding="12,0,12,8" Spacing="4"/>
      </ScrollViewer>

      <Border Grid.Row="2"
              x:Name="Footer"
              Padding="12,8,12,12"
              BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
        <Button Click="OnOpenApp"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="QuickPanelOpenApp">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon FontSize="14" Glyph="&#xE7F4;"/>
            <TextBlock Text="All display settings"/>
          </StackPanel>
        </Button>
      </Border>

    </Grid>
  </Border>
</Window>
