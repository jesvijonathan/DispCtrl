<Page x:Class="DispCtrl.App.Views.Pages.HotkeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:vm="using:DispCtrl.App.ViewModels"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">

  <Page.Resources>
    <!-- One key of a combination, drawn like a keycap. -->
    <DataTemplate x:Key="Keycap" x:DataType="x:String">
      <Border Padding="8,3,8,4" CornerRadius="4" BorderThickness="1,1,1,2"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              Background="{ThemeResource ControlFillColorDefaultBrush}">
        <TextBlock Text="{x:Bind}" FontSize="12" FontFamily="Segoe UI Variable Text Semibold"/>
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="KeycapRow">
      <StackPanel Orientation="Horizontal" Spacing="4"/>
    </ItemsPanelTemplate>
  </Page.Resources>

  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="4" HorizontalAlignment="Stretch">

      <StackPanel Spacing="4" Margin="0,0,0,12">
        <TextBlock Text="Hotkeys" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="{x:Bind ViewModel.EngineNote, Mode=OneWay}"
                   Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <!-- Four jobs, one at a time: the page used to scroll through shortcuts,
           features, triggers and Windows' own keys as one list. -->
      <SelectorBar x:Name="Sections" SelectionChanged="OnSection" Margin="-12,0,0,8">
        <SelectorBarItem Text="Shortcuts" IsSelected="True" AutomationProperties.Name="HotkeysShortcutsTab"/>
        <SelectorBarItem Text="Features" AutomationProperties.Name="HotkeysFeaturesTab"/>
        <SelectorBarItem Text="Triggers" AutomationProperties.Name="HotkeysTriggersTab"/>
        <SelectorBarItem Text="Windows' own" AutomationProperties.Name="HotkeysWindowsTab"/>
      </SelectorBar>

      <StackPanel x:Name="ShortcutsSection" Spacing="4">
      <Grid Margin="0,0,0,8" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind ViewModel.Counts, Mode=OneWay}" VerticalAlignment="Center"
                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <Button Grid.Column="1" Click="OnAdd" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="AddHotkey">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="14"/>
            <TextBlock Text="Add a shortcut"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Click="OnRestoreDefaults" AutomationProperties.Name="RestoreHotkeys"
                ToolTipService.ToolTip="Replace every shortcut with DispCtrl's own set: four on, the rest set up but off.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE777;" FontSize="14"/>
            <TextBlock Text="Restore the defaults"/>
          </StackPanel>
        </Button>
      </Grid>

      <InfoBar x:Name="Toast" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,8"/>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,8"
               Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
               Title="No shortcuts"
               Message="Add one, or restore DispCtrl's own set."/>

      <ItemsControl ItemsSource="{x:Bind ViewModel.Items}" HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HotkeyViewModel">
            <tk:SettingsExpander Header="{x:Bind Summary, Mode=OneWay}"
                                 Description="{x:Bind StateText, Mode=OneWay}"
                                 IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
              <tk:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE765;"/>
              </tk:SettingsExpander.HeaderIcon>

              <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{x:Bind KeyParts, Mode=OneWay}" VerticalAlignment="Center"
                              ItemTemplate="{StaticResource Keycap}" ItemsPanel="{StaticResource KeycapRow}"/>
                <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                              AutomationProperties.Name="HotkeyEnabled"/>
              </StackPanel>

              <tk:SettingsExpander.Items>
                <tk:SettingsCard Header="Keys" Description="{x:Bind KeysNote, Mode=OneWay}">
                  <Button Content="{x:Bind CaptureLabel, Mode=OneWay}" Click="OnCapture" Tag="{x:Bind}"
                          AutomationProperties.Name="SetHotkey"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="What it does" Description="Choose what it works on, then the action.">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Bind CategoryNames}"
                              SelectedIndex="{x:Bind SelectedCategoryIndex, Mode=TwoWay}"
                              MinWidth="200" AutomationProperties.Name="HotkeyCategory"/>
                    <ComboBox ItemsSource="{x:Bind ActionNames, Mode=OneWay}"
                              SelectedIndex="{x:Bind SelectedActionIndex, Mode=TwoWay}"
                              MinWidth="280" AutomationProperties.Name="HotkeyAction"/>
                  </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Step" Description="How far one press moves it, in percent."
                                 Visibility="{x:Bind StepVisibility, Mode=OneWay}">
                  <NumberBox Value="{x:Bind Step, Mode=TwoWay}" Minimum="1" Maximum="100" SmallChange="1"
                             SpinButtonPlacementMode="Compact" Width="110" AutomationProperties.Name="HotkeyStep"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Display" Description="Numbered as Identify numbers them."
                                 Visibility="{x:Bind DisplayVisibility, Mode=OneWay}">
                  <ComboBox ItemsSource="{x:Bind DisplayChoices, Mode=OneWay}"
                            SelectedIndex="{x:Bind SelectedDisplayIndex, Mode=TwoWay}"
                            MinWidth="260" AutomationProperties.Name="HotkeyDisplay"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Preset" Visibility="{x:Bind PresetVisibility, Mode=OneWay}">
                  <ComboBox ItemsSource="{x:Bind Presets, Mode=OneWay}" SelectedItem="{x:Bind SelectedPreset, Mode=TwoWay}"
                            PlaceholderText="Choose a preset" MinWidth="200" AutomationProperties.Name="HotkeyPreset"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Control" Description="The monitor control, by its name or its code."
                                 Visibility="{x:Bind ControlVisibility, Mode=OneWay}">
                  <TextBox Text="{x:Bind Control, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           PlaceholderText="picture-mode, input-source or 0x15"
                           MinWidth="240" AutomationProperties.Name="HotkeyControl"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Value" Description="A value name, a number, next, previous, +N or -N."
                                 Visibility="{x:Bind ValueVisibility, Mode=OneWay}">
                  <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           MinWidth="200" AutomationProperties.Name="HotkeyControlValue"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Feature" Visibility="{x:Bind FeatureVisibility, Mode=OneWay}">
                  <ComboBox ItemsSource="{x:Bind Features, Mode=OneWay}" SelectedItem="{x:Bind SelectedFeature, Mode=TwoWay}"
                            PlaceholderText="Choose a feature" MinWidth="220" AutomationProperties.Name="HotkeyFeature"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Arrangement" Description="Takes a few seconds and blacks the screens, as Win+P does."
                                 Visibility="{x:Bind ModeVisibility, Mode=OneWay}">
                  <ComboBox ItemsSource="{x:Bind ModeNames}" SelectedIndex="{x:Bind SelectedModeIndex, Mode=TwoWay}"
                            MinWidth="200" AutomationProperties.Name="HotkeyMode"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="{x:Bind CommandHeader, Mode=OneWay}" Description="{x:Bind CommandHint, Mode=OneWay}"
                                 Visibility="{x:Bind CommandVisibility, Mode=OneWay}">
                  <TextBox Text="{x:Bind Command, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           MinWidth="280" AutomationProperties.Name="HotkeyCommand"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Arguments" Description="Passed to the program; leave empty for none."
                                 Visibility="{x:Bind ArgumentsVisibility, Mode=OneWay}">
                  <TextBox Text="{x:Bind Arguments, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           MinWidth="280" AutomationProperties.Name="HotkeyArguments"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Remove this shortcut">
                  <Button Content="Remove" Click="OnRemove" Tag="{x:Bind}" AutomationProperties.Name="RemoveHotkey"/>
                </tk:SettingsCard>
              </tk:SettingsExpander.Items>
            </tk:SettingsExpander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      </StackPanel>

      <StackPanel x:Name="FeaturesSection" Spacing="4" Visibility="Collapsed">
      <TextBlock Text="A feature is a named list of monitor writes, dispctrl commands, waits and scripts. Run one from here, a hotkey, the command line or a quick-panel command tile."
                 Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <tk:SettingsExpander Header="Step grammar" Description="Copy these forms into a feature's steps.">
        <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE946;"/></tk:SettingsExpander.HeaderIcon>
        <TextBlock Text="{x:Bind ViewModel.FeatureGrammar}" FontFamily="Consolas" TextWrapping="Wrap"/>
      </tk:SettingsExpander>
      <Button Content="New feature" Click="OnAddFeature" HorizontalAlignment="Left" Margin="0,4,0,4"
              AutomationProperties.Name="NewFeature"/>
      <ItemsControl ItemsSource="{x:Bind ViewModel.Features}" HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CustomFeatureViewModel">
            <tk:SettingsExpander Header="{x:Bind Name, Mode=OneWay}" Description="{x:Bind Status, Mode=OneWay}"
                                 IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
              <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8F1;"/></tk:SettingsExpander.HeaderIcon>
              <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <tk:SettingsExpander.Items>
                <tk:SettingsCard Header="Name">
                  <TextBox Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MinWidth="260"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Description">
                  <TextBox Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MinWidth="320"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Steps" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                  <TextBox Text="{x:Bind Steps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                           MinHeight="120" HorizontalAlignment="Stretch"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Actions">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Run" Click="OnRunFeature" Tag="{x:Bind}"/>
                    <Button Content="Test" Click="OnTestFeature" Tag="{x:Bind}"/>
                    <Button Content="Save" Click="OnSaveFeature" Tag="{x:Bind}" Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="Delete" Click="OnDeleteFeature" Tag="{x:Bind}"/>
                  </StackPanel>
                </tk:SettingsCard>
              </tk:SettingsExpander.Items>
            </tk:SettingsExpander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      </StackPanel>

      <StackPanel x:Name="TriggersSection" Spacing="4" Visibility="Collapsed">
      <TextBlock Text="When something happens, run a feature: a display connected or disconnected, an app coming to the front or leaving it, being away and coming back, locking, power, waking, a time of day. The engine runs them."
                 Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <!-- Built in code from triggers list, like the company switches: one
           place, the control API, says what a trigger is and whether it can run. -->
      <StackPanel x:Name="TriggerRows" Spacing="8"/>

      </StackPanel>

      <!-- What Windows already does, so nobody binds over it or looks for it here. -->
      <StackPanel x:Name="WindowsSection" Spacing="4" Visibility="Collapsed">
      <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="Built into Windows and always available. DispCtrl does not change them; they are here so you need not bind over them."/>
      <tk:SettingsCard Header="Switch between PC screen only, duplicate, extend and second screen only">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;"/></tk:SettingsCard.HeaderIcon>
        <ItemsControl ItemsSource="{x:Bind WinP}" ItemTemplate="{StaticResource Keycap}" ItemsPanel="{StaticResource KeycapRow}"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Move the active window to the next display">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A7;"/></tk:SettingsCard.HeaderIcon>
        <ItemsControl ItemsSource="{x:Bind WinShiftArrow}" ItemTemplate="{StaticResource Keycap}" ItemsPanel="{StaticResource KeycapRow}"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="HDR on or off" Description="On displays that support it.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B9;"/></tk:SettingsCard.HeaderIcon>
        <ItemsControl ItemsSource="{x:Bind WinAltB}" ItemTemplate="{StaticResource Keycap}" ItemsPanel="{StaticResource KeycapRow}"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Quick Settings, with Windows' brightness slider"
                       Description="With Replace Windows brightness on (Brightness page), that slider and the brightness keys move every display.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE706;"/></tk:SettingsCard.HeaderIcon>
        <ItemsControl ItemsSource="{x:Bind WinA}" ItemTemplate="{StaticResource Keycap}" ItemsPanel="{StaticResource KeycapRow}"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Cast to a wireless display">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE703;"/></tk:SettingsCard.HeaderIcon>
        <ItemsControl ItemsSource="{x:Bind WinK}" ItemTemplate="{StaticResource Keycap}" ItemsPanel="{StaticResource KeycapRow}"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Colour filters on or off" Description="Once the shortcut is allowed in Accessibility, Colour filters.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;"/></tk:SettingsCard.HeaderIcon>
        <ItemsControl ItemsSource="{x:Bind WinCtrlC}" ItemTemplate="{StaticResource Keycap}" ItemsPanel="{StaticResource KeycapRow}"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Restart the graphics driver" Description="The screens go black for a moment. For a display that stopped drawing properly.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72C;"/></tk:SettingsCard.HeaderIcon>
        <ItemsControl ItemsSource="{x:Bind WinCtrlShiftB}" ItemTemplate="{StaticResource Keycap}" ItemsPanel="{StaticResource KeycapRow}"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Open Windows' display settings" Description="Scale, resolution, HDR and night light, in Windows' own Settings.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F8;"/></tk:SettingsCard.HeaderIcon>
        <Button Content="Open" Click="OnOpenWindowsDisplay" AutomationProperties.Name="OpenWindowsDisplaySettings"/>
      </tk:SettingsCard>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
