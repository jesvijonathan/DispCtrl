<Page x:Class="DispCtrl.App.Views.Pages.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">

  <!-- One monitor at a time: pick it, see what it is, name what nobody has.
       The sections are built in code, like the quick panel: which exist depends
       on the monitor, and every action is the same devices.* request the
       command line sends. -->
  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="8" HorizontalAlignment="Stretch" MaxWidth="1100">

      <StackPanel Spacing="4" Margin="0,0,0,8">
        <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="What each monitor's controls are. Most codes are named by the standard; a manufacturer's own are not, and naming one makes it a control on Displays. Share what you name, and every owner of the same model gets it."/>
      </StackPanel>

      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="MonitorPicker" Header="Monitor" MinWidth="320" HorizontalAlignment="Left"
                  SelectionChanged="OnMonitorChosen" AutomationProperties.Name="DevicesMonitor"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button x:Name="ScanButton" Click="OnScan" AutomationProperties.Name="DevicesScan"
                  ToolTipService.ToolTip="Read every attached monitor again now, including any removed from this list. The engine does this by itself for new models.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontSize="14" Glyph="&#xE895;"/>
              <TextBlock Text="Scan"/>
            </StackPanel>
          </Button>
          <Button x:Name="ShareAllButton" Click="OnShareAll" AutomationProperties.Name="Contribute my monitors"
                  ToolTipService.ToolTip="Review one issue containing every model in the list, including built-in and disconnected displays.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontSize="14" Glyph="&#xE898;"/>
              <TextBlock Text="Contribute all"/>
            </StackPanel>
          </Button>
          <Button Click="OnOpenFolder" AutomationProperties.Name="DevicesOpenFolder"
                  ToolTipService.ToolTip="The history and the names made on this PC">
            <FontIcon FontSize="14" Glyph="&#xE838;"/>
          </Button>
          <HyperlinkButton Content="How mapping works" VerticalAlignment="Center"
                           NavigateUri="https://github.com/jesvijonathan/DispCtrl/blob/master/docs/DEVICE-LIBRARY.md"/>
        </StackPanel>
      </Grid>

      <InfoBar x:Name="Result" IsOpen="False" IsClosable="True"/>

      <StackPanel x:Name="Detail" Spacing="8"/>
    </StackPanel>
  </ScrollViewer>
</Page>
