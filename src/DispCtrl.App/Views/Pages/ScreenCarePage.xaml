<Page x:Class="DispCtrl.App.Views.Pages.ScreenCarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:vm="using:DispCtrl.App.ViewModels"
      xmlns:views="using:DispCtrl.App.Views.Controls"
      Loaded="OnLoaded">

  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="4" HorizontalAlignment="Stretch">

      <StackPanel Spacing="4" Margin="0,0,0,16">
        <TextBlock Text="Screen care" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="Focus mode dims everything but the window you are using; OLED protection rests panels you have left; keep awake holds the computer awake or turns the displays off." TextWrapping="Wrap"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <tk:SettingsExpander Expanded="OnExpanderExpanded" Header="Focus mode"
                           Description="Keep the active window clear and dim its surroundings. Applies to windows, not to individual browser tabs."
                           Margin="0,4,0,0">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE890;"/>
        </tk:SettingsExpander.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.FocusEnabled, Mode=TwoWay}" AutomationProperties.Name="FocusMode"/>
        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="Background dimming" Description="0% is unchanged; 100% is black. The active window stays at its normal brightness.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.FocusDim, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" Width="160" AutomationProperties.Name="FocusDim"/>
              <TextBlock Text="{x:Bind ViewModel.FocusDim, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <!-- One choice, not two switches. "Follow the mouse" and "keep the
               hovered window clear" read as the same thing: the first clears
               the window under the pointer instead of the focused one, the
               second as well as it. Both leaves how they were stored alone. -->
          <tk:SettingsCard Header="Which windows stay clear"
                           Description="Both suits reading one window while typing in another. Whenever the pointer counts, pointing at the taskbar clears it too.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE962;"/>
            </tk:SettingsCard.HeaderIcon>
            <ComboBox ItemsSource="{x:Bind ViewModel.FocusClearChoices}"
                      SelectedIndex="{x:Bind ViewModel.FocusClearIndex, Mode=TwoWay}"
                      MinWidth="260" AutomationProperties.Name="FocusClear"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Dim other monitors"
                           Description="Also dim monitors that do not contain the active window. Ignored when each display keeps its own window, since then every display has one. Which displays may be dimmed at all is set on each display, below.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusOtherMonitors, Mode=TwoWay}" AutomationProperties.Name="FocusOtherMonitors"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Right now" Description="{x:Bind ViewModel.ProtectionStatus, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE9E9;"/>
            </tk:SettingsCard.HeaderIcon>
          </tk:SettingsCard>
          <!-- The rest of this section, folded until asked for: see Fold. -->
          <tk:SettingsCard Header="{x:Bind ViewModel.FocusFold.Label, Mode=OneWay}"
                           Description="Timing and transitions, one window per display, which displays and apps are left alone, and reset.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE713;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleButton IsChecked="{x:Bind ViewModel.FocusFold.Open, Mode=TwoWay}" AutomationProperties.Name="FocusAdvanced"
                          ToolTipService.ToolTip="Show or hide the less-used settings">
              <FontIcon Glyph="{x:Bind ViewModel.FocusFold.Glyph, Mode=OneWay}" FontSize="12"/>
            </ToggleButton>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Delay after switching windows" Description="Milliseconds before the background starts to dim."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <NumberBox Value="{x:Bind ViewModel.FocusDelay, Mode=TwoWay}" Minimum="0" Maximum="10000" SmallChange="100" Width="135" SpinButtonPlacementMode="Compact" AutomationProperties.Name="FocusDelay"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Fade duration" Description="Milliseconds, for the dimming appearing and disappearing and for the slide below. Set to 0 for an instant change."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <NumberBox Value="{x:Bind ViewModel.FocusFade, Mode=TwoWay}" Minimum="0" Maximum="2000" SmallChange="50" Width="135" SpinButtonPlacementMode="Compact" AutomationProperties.Name="FocusFade"/>
          </tk:SettingsCard>
          <!-- One choice, not two switches. Both at once meant the shape
               travelled and cross-faded together, which is the worst of the
               pair rather than a blend of them. -->
          <tk:SettingsCard Header="Transition between windows"
                           Description="Fading moves only the brightness and cuts both shapes instantly. Sliding moves the shape across, which is what reads as lag."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE706;"/>
            </tk:SettingsCard.HeaderIcon>
            <ComboBox ItemsSource="{x:Bind ViewModel.WindowTransitions}"
                      SelectedIndex="{x:Bind ViewModel.WindowTransition, Mode=TwoWay}"
                      MinWidth="200"
                      AutomationProperties.Name="WindowTransition"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="One clear window per display"
                           Description="Each display keeps the last window used on it clear, instead of the whole desk sharing one. A display nothing has been opened on stays dimmed."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7F4;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusPerMonitor, Mode=TwoWay}" AutomationProperties.Name="FocusPerMonitor"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="OLED displays only" Description="Dim only the panels marked as OLED, on each display's card on the Displays page."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusOledOnly, Mode=TwoWay}" AutomationProperties.Name="FocusOledOnly"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Match the dimming to brightness"
                           Description="Ease the dimming on panels unison brightness is already running dim, so one setting looks the same on every screen."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE706;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusScaleWithBrightness, Mode=TwoWay}" AutomationProperties.Name="FocusScaleWithBrightness"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Follow new and activated windows"
                           Description="Temporarily keep an app opened or activated by a launcher, script or automation clear. Moving the pointer returns control to mouse following."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE8A7;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusPrioritizeNewWindows, Mode=TwoWay}"
                          AutomationProperties.Name="FocusPrioritizeNewWindows"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Keep taskbar area clear" Description="Leave the space reserved for the taskbar at normal brightness."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusKeepTaskbar, Mode=TwoWay}" AutomationProperties.Name="FocusKeepTaskbar"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Pause for fullscreen windows" Description="Avoid dimming while watching fullscreen content or playing a fullscreen game."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.FocusPauseFullscreen, Mode=TwoWay}" AutomationProperties.Name="FocusPauseFullscreen"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Excluded apps" Description="Pause while one of these apps is active. Separate executable names with commas, for example vlc.exe, game.exe." ContentAlignment="Vertical"
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <TextBox Text="{x:Bind ViewModel.FocusExcludedApps, Mode=TwoWay}" PlaceholderText="App executable names" AutomationProperties.Name="FocusExcludedApps"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Reset focus mode"
                           Description="Puts the settings above back to their defaults. The switch itself is left alone."
                           Visibility="{x:Bind ViewModel.FocusFold.Visibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE777;"/>
            </tk:SettingsCard.HeaderIcon>
            <Button Content="Reset" Click="OnResetFocus" AutomationProperties.Name="ResetFocusSettings"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <!-- One switch, but it reaches only the panels that are both marked OLED
           and have protection left on, so the first card says which those are.
           A global-looking toggle that quietly skips half the desk is the kind
           of control someone has to test to understand. -->
      <tk:SettingsExpander Expanded="OnExpanderExpanded" Header="OLED idle protection"
                           Description="Rest OLED panels after a spell without input. Panels not marked as OLED are never touched."
                           Margin="0,4,0,0">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE7F4;"/>
        </tk:SettingsExpander.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.OledIdleEnabled, Mode=TwoWay}" AutomationProperties.Name="OledIdleProtection"/>
        <tk:SettingsExpander.Items>
          <!-- Every monitor this PC has seen, connected ones first and then
               the most recently seen, so one can be set up while it is unplugged. -->
          <tk:SettingsCard Header="Which displays" Description="{x:Bind ViewModel.OledCoverage, Mode=OneWay}"
                           ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7F4;"/>
            </tk:SettingsCard.HeaderIcon>
            <ItemsControl ItemsSource="{x:Bind ViewModel.OledMonitors}" Margin="0,4,0,8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OledMonitorItem">
                  <StackPanel Spacing="4">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="OLED" IsChecked="{x:Bind IsOled, Mode=TwoWay}" MinWidth="0"
                              AutomationProperties.Name="{x:Bind OledAutomationName}"/>
                    <CheckBox Grid.Column="2" Content="Protect" IsChecked="{x:Bind Protected, Mode=TwoWay}" MinWidth="0"
                              IsEnabled="{x:Bind IsOled, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind ProtectAutomationName}"/>
                  </Grid>
                  <!-- Common or its own: the display follows the timing below
                       until it is given its own, which starts as a copy. -->
                  <CheckBox Content="Same timing as all displays" IsChecked="{x:Bind SameAsAll, Mode=TwoWay}" MinWidth="0"
                            IsEnabled="{x:Bind Protected, Mode=OneWay}" Margin="12,0,0,0"
                            AutomationProperties.Name="{x:Bind SameAutomationName}"/>
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="40,0,0,4" Visibility="{x:Bind OwnVisibility, Mode=OneWay}">
                    <NumberBox Header="Rest after (min)" Value="{x:Bind OwnIdleMinutes, Mode=TwoWay}" Minimum="1" Maximum="120"
                               SpinButtonPlacementMode="Compact" Width="130"/>
                    <NumberBox Header="Dim (%)" Value="{x:Bind OwnDimPercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                               SmallChange="5" SpinButtonPlacementMode="Compact" Width="110"/>
                    <CheckBox Content="Turn off" IsChecked="{x:Bind OwnThirdStage, Mode=TwoWay}" VerticalAlignment="Bottom" MinWidth="0"/>
                    <NumberBox Header="Off after (min)" Value="{x:Bind OwnThirdStageMinutes, Mode=TwoWay}" Minimum="1" Maximum="240"
                               IsEnabled="{x:Bind OwnThirdStage, Mode=OneWay}" SpinButtonPlacementMode="Compact" Width="130"/>
                  </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Dim after inactivity" Description="Minutes without keyboard or mouse input. Input restores the display automatically.">
            <NumberBox Value="{x:Bind ViewModel.OledIdleMinutes, Mode=TwoWay}" Minimum="1" Maximum="120" SmallChange="1" Width="135" SpinButtonPlacementMode="Compact" AutomationProperties.Name="OledIdleMinutes"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Idle dimming" Description="With protection enabled, changes preview for two seconds. 100% is black; this does not run a hardware compensation cycle.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.OledIdleDim, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" Width="160" AutomationProperties.Name="OledIdleDim"/>
              <TextBlock Text="{x:Bind ViewModel.OledIdleDim, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Third stage: turn the display off"
                           Description="After the stages above, black the display out as if it were off. Any input brings it back.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledThirdStageEnabled, Mode=TwoWay}" AutomationProperties.Name="OledThirdStageEnabled"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Turn off after"
                           Description="Additional minutes after the previous stage.">
            <NumberBox Value="{x:Bind ViewModel.OledThirdStageMinutes, Mode=TwoWay}" Minimum="1" Maximum="240" SmallChange="5" Width="135"
                       IsEnabled="{x:Bind ViewModel.OledThirdStageEnabled, Mode=OneWay}"
                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="OledThirdStageMinutes"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Pause during fullscreen content">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledPauseFullscreen, Mode=TwoWay}" AutomationProperties.Name="OledPauseFullscreen"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Pause while a video plays on that display"
                           Description="A display showing a playing video - in a browser or a player, fullscreen or in a window - does not rest. Music playing alone does not count.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledPauseVideo, Mode=TwoWay}" AutomationProperties.Name="OledPauseVideo"/>
          </tk:SettingsCard>
          <!-- The rest of this section, folded until asked for: see Fold. -->
          <tk:SettingsCard Header="{x:Bind ViewModel.OledFold.Label, Mode=OneWay}"
                           Description="A second dimming stage, each display on its own, apps that keep a display awake, what the third stage does to the backlight and the computer, and fading.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE713;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleButton IsChecked="{x:Bind ViewModel.OledFold.Open, Mode=TwoWay}" AutomationProperties.Name="OledAdvanced"
                          ToolTipService.ToolTip="Show or hide the less-used settings">
              <FontIcon Glyph="{x:Bind ViewModel.OledFold.Glyph, Mode=OneWay}" FontSize="12"/>
            </ToggleButton>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Each display rests on its own"
                           Description="A display rests when neither the pointer nor the window you are typing into has been on it for the idle time, even while you work on another. Off, any input keeps every display awake."
                           Visibility="{x:Bind ViewModel.OledFold.Visibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7F4;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledPerDisplayActivity, Mode=TwoWay}" AutomationProperties.Name="OledPerDisplayActivity"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Keep these apps' displays awake"
                           Description="A display showing one of these apps - not minimized - never rests, whichever window has focus: a film or a dashboard you watch without touching. Executable names, separated by commas."
                           ContentAlignment="Vertical"
                           Visibility="{x:Bind ViewModel.OledFold.Visibility, Mode=OneWay}">
            <TextBox Text="{x:Bind ViewModel.OledExcludedApps, Mode=TwoWay}" PlaceholderText="vlc.exe, obs64.exe"
                     AutomationProperties.Name="OledExcludedApps"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Second-stage dimming"
                           Description="After the first dim, reduce the panel again. Available when the first level is between 1% and 99%."
                           Visibility="{x:Bind ViewModel.OledSecondStageVisibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledSecondStageEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="OledSecondStageEnabled"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Second stage after"
                           Description="Additional minutes spent at the first dimming level."
                           Visibility="{x:Bind ViewModel.OledSecondStageVisibility, Mode=OneWay}">
            <NumberBox Value="{x:Bind ViewModel.OledSecondStageMinutes, Mode=TwoWay}"
                       Minimum="1" Maximum="120" SmallChange="1" Width="135"
                       IsEnabled="{x:Bind ViewModel.OledSecondStageEnabled, Mode=OneWay}"
                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="OledSecondStageMinutes"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Second-stage dimming level"
                           Description="The final dimming level; it cannot be lighter than the first stage."
                           Visibility="{x:Bind ViewModel.OledSecondStageVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.OledSecondStageDim, Mode=TwoWay}"
                      Minimum="{x:Bind ViewModel.OledIdleDim, Mode=OneWay}" Maximum="100" StepFrequency="5" Width="160"
                      IsEnabled="{x:Bind ViewModel.OledSecondStageEnabled, Mode=OneWay}"
                      AutomationProperties.Name="OledSecondStageDim"/>
              <TextBlock Text="{x:Bind ViewModel.OledSecondStageDim, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Third stage: backlight off too"
                           Description="Turn the display's own brightness to its lowest while it is off, as Turn off displays does, and back when it wakes."
                           Visibility="{x:Bind ViewModel.OledFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledThirdStageBacklight, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.OledThirdStageEnabled, Mode=OneWay}" AutomationProperties.Name="OledThirdStageBacklight"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Third stage: keep the computer active"
                           Description="On, Keep awake and Stay active carry on while a display is off. Off, a display reaching this stage means nobody is there: DispCtrl stops holding the computer awake, and Windows may lock or sleep on its own timers."
                           Visibility="{x:Bind ViewModel.OledFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OledThirdStageKeepActive, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.OledThirdStageEnabled, Mode=OneWay}" AutomationProperties.Name="OledThirdStageKeepActive"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Idle fade duration" Description="Milliseconds to reach the idle dimming level."
                           Visibility="{x:Bind ViewModel.OledFold.Visibility, Mode=OneWay}">
            <NumberBox Value="{x:Bind ViewModel.OledIdleFade, Mode=TwoWay}" Minimum="0" Maximum="2000" SmallChange="100" Width="135" SpinButtonPlacementMode="Compact" AutomationProperties.Name="OledIdleFade"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Reset OLED idle protection"
                           Description="Puts the settings above back to their defaults. Which panels are OLED is set on each display."
                           Visibility="{x:Bind ViewModel.OledFold.Visibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE777;"/>
            </tk:SettingsCard.HeaderIcon>
            <Button Content="Reset" Click="OnResetOled" AutomationProperties.Name="ResetOledSettings"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <tk:SettingsExpander Expanded="OnExpanderExpanded" Header="Keep awake"
                           Description="Stop the computer sleeping without changing the Windows power plan, stay shown as available, and turn the displays off while it keeps running."
                           Margin="0,4,0,0">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE916;"/>
        </tk:SettingsExpander.HeaderIcon>
        <Button Content="Reset" Click="OnResetAwake" AutomationProperties.Name="ResetAwakeSettings"/>
        <tk:SettingsExpander.Items>
          <!-- Here rather than a section of its own: turning the displays off
               is how someone walks away, and staying awake is what they want
               while they are gone. -->
          <!-- Staying awake or active meanwhile is this section's own Mode and
               Stay active, not a second copy: one setting wherever it is shown. -->
          <tk:SettingsCard Header="Turn off displays"
                           Description="{x:Bind ViewModel.DisplaysOffShortcut, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7E8;"/>
            </tk:SettingsCard.HeaderIcon>
            <Button Content="Turn off now" Click="OnTurnOffDisplays" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="TurnOffDisplays"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Stay active"
                           Description="Until you switch it off: the screen stays on, and a tiny pointer nudge after a minute idle stops the lock screen and chat apps showing you as Away. OLED idle dimming still comes: the nudge is not taken for you.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.AwakeStayActive, Mode=TwoWay}"
                          AutomationProperties.Name="AwakeStayActive"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Mode" Description="Choose when the engine should hold a Windows power request.">
            <ComboBox ItemsSource="{x:Bind ViewModel.AwakeModes}"
                      SelectedIndex="{x:Bind ViewModel.AwakeModeIndex, Mode=TwoWay}"
                      MinWidth="240" AutomationProperties.Name="AwakeMode"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Time interval" Description="Changing this restarts the interval."
                           Visibility="{x:Bind ViewModel.AwakeTimedVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <NumberBox Value="{x:Bind ViewModel.AwakeHours, Mode=TwoWay}" Minimum="0" Maximum="168" Width="105" Header="Hours" SpinButtonPlacementMode="Compact"/>
              <NumberBox Value="{x:Bind ViewModel.AwakeMinutes, Mode=TwoWay}" Minimum="0" Maximum="59" Width="105" Header="Minutes" SpinButtonPlacementMode="Compact"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Expiration" Description="Return to the selected power plan at this local date and time."
                           Visibility="{x:Bind ViewModel.AwakeExpirationVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <DatePicker Date="{x:Bind ViewModel.AwakeExpirationDate, Mode=TwoWay}"/>
              <TimePicker Time="{x:Bind ViewModel.AwakeExpirationTime, Mode=TwoWay}"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Right now" Description="{x:Bind ViewModel.AwakeStatus, Mode=OneWay}"/>
          <!-- The rest of this section, folded until asked for: see Fold. -->
          <tk:SettingsCard Header="{x:Bind ViewModel.AwakeFold.Label, Mode=OneWay}"
                           Description="How dark, which displays, what wakes them, locking, and keeping displays on.">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE713;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleButton IsChecked="{x:Bind ViewModel.AwakeFold.Open, Mode=TwoWay}" AutomationProperties.Name="AwakeAdvanced"
                          ToolTipService.ToolTip="Show or hide the less-used settings">
              <FontIcon Glyph="{x:Bind ViewModel.AwakeFold.Glyph, Mode=OneWay}" FontSize="12"/>
            </ToggleButton>
          </tk:SettingsCard>
          <tk:SettingsCard Header="How dark they go" Description="100% is black. The monitors stay on underneath, and so does everything on them."
                           Visibility="{x:Bind ViewModel.AwakeFold.Visibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Slider Value="{x:Bind ViewModel.DisplaysOffLevel, Mode=TwoWay}" Minimum="50" Maximum="100" StepFrequency="5"
                      Width="200" AutomationProperties.Name="DisplaysOffLevel"/>
              <TextBlock Text="{x:Bind ViewModel.DisplaysOffLevel, Mode=OneWay}" VerticalAlignment="Center" MinWidth="28"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Turn the backlight down too"
                           Description="At 90% darkness and more: each display that lets DispCtrl set its brightness goes to its lowest, and back to where it was as it wakes."
                           IsEnabled="{x:Bind ViewModel.DisplaysOffBacklightAvailable, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.AwakeFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.DisplaysOffBacklight, Mode=TwoWay}" AutomationProperties.Name="DisplaysOffBacklight"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Which displays go off" Description="Decided when they go off, so the pointer and the active window count where they are then."
                           Visibility="{x:Bind ViewModel.AwakeFold.Visibility, Mode=OneWay}">
            <ComboBox ItemsSource="{x:Bind ViewModel.DisplaysOffTargets}" SelectedIndex="{x:Bind ViewModel.DisplaysOffTargetIndex, Mode=TwoWay}"
                      MinWidth="240" AutomationProperties.Name="DisplaysOffTarget"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Delay before they go off" Description="Time to take your hand off the mouse, or to move the pointer to the display you are keeping."
                           Visibility="{x:Bind ViewModel.AwakeFold.Visibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Slider Value="{x:Bind ViewModel.DisplaysOffDelay, Mode=TwoWay}" Minimum="0" Maximum="30" StepFrequency="1"
                      Width="200" AutomationProperties.Name="DisplaysOffDelay"/>
              <TextBlock Text="{x:Bind ViewModel.DisplaysOffDelay, Mode=OneWay}" VerticalAlignment="Center" MinWidth="28"/>
              <TextBlock Text="s" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Wake only by the pointer"
                           Description="A display comes back when the pointer moves on it; typing leaves it off. Off: any input wakes them all."
                           Visibility="{x:Bind ViewModel.AwakeFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.DisplaysOffWakeOnPointer, Mode=TwoWay}" AutomationProperties.Name="DisplaysOffWakeOnPointer"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Hide the pointer"
                           Description="Parks it in a corner of a display that went off, so no arrow floats on the black. Put back afterwards unless the mouse woke them."
                           Visibility="{x:Bind ViewModel.AwakeFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.DisplaysOffHidePointer, Mode=TwoWay}" AutomationProperties.Name="DisplaysOffHidePointer"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Lock when they wake"
                           Description="Everything keeps running behind the black, and whoever brings the displays back meets the lock screen. Any way of turning them back on locks, the shortcuts included."
                           Visibility="{x:Bind ViewModel.AwakeFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.DisplaysOffLockOnWake, Mode=TwoWay}" AutomationProperties.Name="DisplaysOffLockOnWake"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Keep displays on"
                           Description="Also prevent display timeout while keep-awake is active. Manual sleep commands still work."
                           Visibility="{x:Bind ViewModel.AwakeFold.Visibility, Mode=OneWay}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.AwakeKeepDisplaysOn, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.AwakeOptionsEnabled, Mode=OneWay}"
                          AutomationProperties.Name="AwakeKeepDisplaysOn"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

    </StackPanel>
  </ScrollViewer>
</Page>
