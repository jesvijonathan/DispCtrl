<Page x:Class="DispCtrl.App.Views.Pages.DisplaysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:vm="using:DispCtrl.App.ViewModels"
      xmlns:views="using:DispCtrl.App.Views.Controls"
      Loaded="OnLoaded">

  <Page.Resources>
    <!-- One style per kind of cell in the information table, so the block reads
         as a table rather than as a pile of individually styled text.

         Top aligned rather than centred: a value long enough to wrap used to
         pull its own label down into the middle of the two lines, which is what
         made a column of otherwise tidy pairs look ragged. -->
    <Style x:Key="InfoSection" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,12,0,2"/>
    </Style>
    <Style x:Key="InfoLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="InfoValue" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="IsTextSelectionEnabled" Value="True"/>
    </Style>
    <!-- Serials, device names and identity tokens: monospaced because they are
         read a character at a time, and dimmed because they only matter when
         something has gone wrong. -->
    <Style x:Key="InfoIdentifier" TargetType="TextBlock"
           BasedOn="{StaticResource InfoValue}">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

  <ScrollViewer Grid.Row="0" Padding="0,0,0,32">
    <!-- Stretch with no MaxWidth. The cap was the problem: a Stretch panel
           with a MaxWidth centres itself once the window exceeds that width,
           which is what pushed content off to one side. Pinning it Left instead
           fixed the drift but made the panel size to its content, so cards
           stopped filling. Filling at every width is what Windows Settings
           does, and the side padding already keeps line length sane. -->
      <StackPanel Padding="36,12,36,0" Spacing="0"
                  HorizontalAlignment="Stretch">

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Displays" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="{x:Bind ViewModel.TopologyText, Mode=OneWay}"
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Button Grid.Column="1" Click="OnRescan"
                VerticalAlignment="Bottom" Width="40" Height="36" Padding="0"
                ToolTipService.ToolTip="Rescan displays"
                AutomationProperties.Name="Rescan displays">
          <FontIcon Glyph="&#xE72C;" FontSize="16"/>
        </Button>
      </Grid>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
               Visibility="{x:Bind ViewModel.InactiveVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.InactiveText, Mode=OneWay}"/>

      <!-- The arrangement leads the page. It is the picture of the desk, and
           everything below it is a setting belonging to one of the panels in
           that picture, so it reads as the subject rather than as one more card
           among the settings. Detect, Identify, Reset and Apply all live inside
           the surface, because each of them is about the diagram.

           Deliberately not a SettingsCard. That control reserves a header
           gutter and places content in its right-hand action area whatever
           ContentAlignment says, so a wide child ends up stranded in a narrow
           column — glaring once the window is maximised. A plain header plus a
           full-width block is what actually spans. -->
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <FontIcon Glyph="&#xE80A;" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Arrange displays"/>
            <TextBlock Text="Drag a display to match where it physically sits. Nothing changes until you apply."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>
        <views:ArrangeCanvas x:Name="ArrangeSurface" Margin="0,4,0,4"/>
      </StackPanel>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,4"
               Visibility="{x:Bind ViewModel.DetectStatusVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.DetectStatus, Mode=OneWay}"/>

      <!-- The same four choices as Win+P, applied through the documented
           topology flags so Windows reuses the arrangement you last had. -->
      <tk:SettingsCard Header="Multiple displays"
                       Description="{x:Bind ViewModel.ArrangementsDescription, Mode=OneWay}">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7F4;"/>
        </tk:SettingsCard.HeaderIcon>
        <ComboBox ItemsSource="{x:Bind ViewModel.Arrangements}"
                  SelectedItem="{x:Bind ViewModel.SelectedArrangement, Mode=TwoWay}"
                  IsEnabled="{x:Bind ViewModel.ArrangementsApply, Mode=OneWay}"
                  MinWidth="240"/>
      </tk:SettingsCard>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Margin="0,4,0,0"
               Visibility="{x:Bind ViewModel.ArrangementStatusVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.ArrangementStatus, Mode=OneWay}"/>

      <!-- The device library has its own page: every monitor seen, mapping the
           codes nobody has named, and sharing one model at a time. -->
      <tk:SettingsCard Header="Monitor library"
                       Description="Every monitor this PC has seen, what each of its controls does, and sharing that with the project so the same model works for everyone."
                       IsClickEnabled="True" Click="OnOpenDevices"
                       AutomationProperties.Name="OpenDevicesPage">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE9F9;"/>
        </tk:SettingsCard.HeaderIcon>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Connect to a wireless display"
                       Description="Opens Windows' own pairing flow — Miracast discovery and PIN entry belong there.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7F7;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button Content="Connect" Click="OnConnectWireless"/>
      </tk:SettingsCard>



      <TextBlock Text="Each display"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <!-- Deliberately ItemsControl, not ItemsRepeater. ItemsRepeater
           virtualises: expanding a card near the bottom grew the extent, which
           scrolled the card out of the realisation window, which recycled the
           element and collapsed it, which shrank the extent again — a visible
           open/close flicker that fed itself. There are two or three displays
           here; there is nothing to virtualise, and realising them all also
           means the hardware reads start immediately instead of when a card
           first scrolls into view. -->
      <ItemsControl ItemsSource="{x:Bind ViewModel.Displays, Mode=OneWay}"
                    HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DisplayViewModel">

            <tk:SettingsExpander Expanded="OnExpanderExpanded" Loaded="OnDisplayCardLoaded" IsExpanded="{x:Bind StartsOpen}"
                                 Header="{x:Bind Name}" Description="{x:Bind Details}">
              <tk:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE7F4;"/>
              </tk:SettingsExpander.HeaderIcon>

              <TextBlock Text="{x:Bind SummaryLine, Mode=OneWay}"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

              <tk:SettingsExpander.Items>
                <!-- Information first: the panel on the left, and everything it
                     reports in one block pinned to the right edge.

                     Pinned rather than spread across the card, because that is
                     the grammar of every other row on this page — what the
                     thing is on the left, what it says or does on the right.
                     Left to fill the width, the table put its labels hard
                     against the icon gutter and its values adrift in the middle
                     of an otherwise empty row, lining up with nothing above or
                     below it.

                     SettingsCard keeps its icon/header gutter even with
                     ContentAlignment="Vertical", so content is always indented
                     past it. Rather than fight that, the card is given a real
                     header: the content then aligns under the header text,
                     which is how Windows Settings lays out an expanded card —
                     deliberate rather than a gap. -->
                <tk:SettingsCard ContentAlignment="Vertical"
                                 HorizontalContentAlignment="Stretch">
                  <Grid ColumnSpacing="24" RowSpacing="16" Padding="0,4,0,8"
                        SizeChanged="OnDisplayOverviewSizeChanged" RowDefinitions="Auto,Auto">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- The panel itself, drawn at its real aspect ratio with
                         its own wallpaper in it — the same idea as the preview
                         in Windows' Display settings. -->
                    <!-- Centred on both axes, so it sits in the middle of the
                         space between the card edge and the table beside it. -->
                    <Viewbox Grid.Column="1" MaxWidth="340" Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                      <Border Width="{x:Bind PreviewWidth}"
                              Height="{x:Bind PreviewHeight}"
                              HorizontalAlignment="Center"
                              CornerRadius="6"
                              BorderThickness="2"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <Grid>
                          <Image Source="{x:Bind WallpaperImage, Mode=OneWay}"
                                 Stretch="UniformToFill"
                                 Visibility="{x:Bind HasWallpaper, Mode=OneWay}"/>
                          <!-- A dark wallpaper left the tile looking like an
                               empty box; the scrim keeps the number legible
                               whatever is behind it. The number itself sits
                               straight on the panel with no chip, which is how
                               Windows draws it — the chip was the detail that
                               made this read as an imitation of the real one. -->
                          <Border Background="#59000000"/>
                          <TextBlock Text="{x:Bind Number}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontSize="48" FontWeight="SemiBold"
                                     Foreground="White"/>
                        </Grid>
                      </Border>

                      <TextBlock Text="{x:Bind PreviewCaption}"
                                 HorizontalAlignment="Center"
                                 Style="{StaticResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    </Viewbox>

                    <!-- Everything the display says, as one block against the
                         right edge. Capped rather than stretched: a table that
                         grows with the window ends up with a hand's width of
                         nothing between each label and its value. -->
                    <Grid Grid.Column="0" RowSpacing="8"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          MaxWidth="660">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>

                      <!-- The whole table, in one press, and attached to the
                           block it copies. Every value below is selectable, but
                           dragging a selection through thirty rows of a
                           scrolling list is not what someone should have to do
                           to paste their monitor into a support thread. -->
                      <!-- On the caption's line, not a row of its own: alone,
                           it opened a gap above the table that belonged to
                           nothing. Drawn after the table, so it sits on top. -->
                      <Button Grid.Row="1" Canvas.ZIndex="1" Click="OnCopyInfo" Tag="{x:Bind}"
                              Width="40" Height="36" Padding="0"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,-8,0,0"
                              ToolTipService.ToolTip="Copy these details"
                              AutomationProperties.Name="{x:Bind CopyInfoAutomationName}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                      </Button>

                      <!-- Scrolled, with a ceiling. This is thirty-odd rows and
                           it is the first thing an expanded card shows: at full
                           height it pushed every actual control for the display
                           past the bottom of the window, so the table had to be
                           scrolled past rather than read. Chaining is left on,
                           so the wheel carries on down the page once the table
                           is at its end. -->
                      <ScrollViewer Grid.Row="1"
                                    MaxHeight="360"
                                    Padding="0,0,12,0"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled">
                        <!-- ItemsControl, not ItemsRepeater: the same
                             virtualisation trap as the display list above, and
                             there is nothing here worth virtualising. -->
                        <ItemsControl ItemsSource="{x:Bind Information, Mode=OneWay}"
                                      HorizontalContentAlignment="Stretch">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoRow">
                              <!-- One fixed label column for every row, which is
                                   what makes the values line up. Sized per row,
                                   each pair found its own width and the column
                                   of values came out ragged. -->
                              <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="190"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{x:Bind Label}"
                                           Visibility="{x:Bind SectionVisibility}"
                                           Style="{StaticResource InfoSection}"/>

                                <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                           Visibility="{x:Bind FieldVisibility}"
                                           Style="{StaticResource InfoLabel}"/>

                                <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                           Visibility="{x:Bind ProseVisibility}"
                                           Style="{StaticResource InfoValue}"/>

                                <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                           Visibility="{x:Bind IdentifierVisibility}"
                                           Style="{StaticResource InfoIdentifier}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </Grid>
                </tk:SettingsCard>
                <!-- Then wallpaper, then brightness, then the rest. -->
                <tk:SettingsCard Header="Wallpaper" Description="{x:Bind WallpaperName, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Change…" Click="OnPickWallpaper" Tag="{x:Bind}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Fit"
                                 Description="How the image is scaled to the screen. Windows applies the fit mode to every display.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9A6;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind WallpaperFits}"
                            SelectedItem="{x:Bind SelectedWallpaperFit, Mode=TwoWay}"
                            MinWidth="140"/>
                </tk:SettingsCard>
                <!-- Wrapped in a card, not placed bare. SettingsExpander.Items
                     only accepts card-like children; a raw InfoBar here takes
                     the process down when the expander realises its content. -->
                <tk:SettingsCard ContentAlignment="Vertical"
                                 Visibility="{x:Bind SystemWideWallpaperNotice}">
                  <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                           HorizontalAlignment="Stretch" Margin="0,0,0,8"
                           Message="Per-monitor wallpaper is unavailable on this machine — the IDesktopWallpaper COM class has no registered server, so a change here applies to every display."/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Brightness" Description="{x:Bind BrightnessBackend}"
                                 Visibility="{x:Bind BrightnessVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Named per display: two identically-labelled sliders on
                         one page are indistinguishable to a screen reader. -->
                    <Slider Value="{x:Bind BrightnessPercent, Mode=TwoWay}"
                            Minimum="0" Maximum="100" StepFrequency="1"
                            Width="220" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind BrightnessAutomationName}"/>
                    <TextBlock Text="{x:Bind BrightnessPercent, Mode=OneWay}"
                               VerticalAlignment="Center" MinWidth="32"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </tk:SettingsCard>
                <!-- Power Display's "exclude from linked brightness". -->
                <tk:SettingsCard Header="In unison" Description="{x:Bind InUnisonDescription, Mode=OneWay}"
                                 Visibility="{x:Bind BrightnessVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind InUnison, Mode=TwoWay}" AutomationProperties.Name="{x:Bind InUnisonAutomationName}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Brightness"
                                 Description="This display does not report brightness control."
                                 Visibility="{x:Bind NoBrightnessVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Unavailable" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Night light"
                                 Description="{x:Bind NightLightStrengthText, Mode=OneWay}"
                                 Visibility="{x:Bind NightLightVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="Same as all displays" IsChecked="{x:Bind NightLightSameAsAll, Mode=TwoWay}" MinWidth="0"
                              VerticalAlignment="Center" AutomationProperties.Name="{x:Bind SameWarmthAutomationName}"/>
                    <Slider Value="{x:Bind NightLightStrength, Mode=TwoWay}"
                            Minimum="5" Maximum="100" StepFrequency="1"
                            Width="220" VerticalAlignment="Center" IsEnabled="{x:Bind NightLightOwn, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind WarmthAutomationName}"/>
                  </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="HDR" Description="{x:Bind HdrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind HdrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind HdrEnabled, Mode=TwoWay}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="HDR" Description="{x:Bind HdrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind NoHdrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Not supported" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Scale"
                                 Description="Applies immediately. Some apps only pick up a scale change when restarted."
                                 Visibility="{x:Bind ScalingVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind ScalingOptions}"
                            SelectedItem="{x:Bind SelectedScaling, Mode=TwoWay}"
                            MinWidth="140"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Scale" Description="Windows did not report scaling steps for this display."
                                 Visibility="{x:Bind NoScalingVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="{x:Bind ScaleText}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Resolution"
                                 Description="Changing resolution forces a full mode switch, so the screen will blank briefly.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind Resolutions}"
                            SelectedItem="{x:Bind SelectedResolution, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Refresh rate"
                                 Description="Changing only the rate is submitted as a timing change, which most drivers apply without blanking.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind RefreshRates}"
                            SelectedItem="{x:Bind SelectedRefreshRate, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Orientation" Description="Rotating swaps the resolution automatically.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7AD;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind Orientations}"
                            SelectedItem="{x:Bind SelectedOrientation, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Main display" Description="{x:Bind RoleAndConnection}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9CE;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Grid>
                    <Button Content="Make this my main display"
                            Click="OnMakePrimary" Tag="{x:Bind}"
                            Visibility="{x:Bind SetPrimaryVisibility, Mode=OneWay}"/>
                    <TextBlock Text="This is your main display"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind IsPrimaryVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </Grid>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Hide the taskbar" Description="{x:Bind HideTaskbarDescription}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Grid>
                    <ToggleSwitch IsOn="{x:Bind HideTaskbar, Mode=TwoWay}"
                                  Visibility="{x:Bind ToggleVisibility}"/>
                    <!-- The primary display gets Windows' own auto-hide here,
                         rather than a dead control and a pointer elsewhere. -->
                    <ToggleSwitch IsOn="{x:Bind PrimaryAutoHide, Mode=TwoWay}"
                                  Visibility="{x:Bind PrimaryNoteVisibility}"/>
                  </Grid>
                </tk:SettingsCard>
                <!-- Discovered, not assumed: the list comes from the panel's
                     own capabilities string, so it is exactly what this monitor
                     has, and most of it is reachable nowhere in Windows.

                     Deliberately a SettingsCard and not a nested
                     SettingsExpander. SettingsExpander.Items accepts only
                     card-like children, and an expander inside one does not
                     fail to render — it takes the process down when the item is
                     realised. That has now cost this project two crashes. -->
                <!-- The DDC/CI guard's notice, in a card like the wallpaper one:
                     a bare InfoBar in Items takes the process down. -->
                <tk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"
                                 Visibility="{x:Bind DdcBlockedVisibility, Mode=OneWay}">
                  <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                           HorizontalAlignment="Stretch" Margin="0,0,0,8"
                           Title="DDC/CI is off for this monitor"
                           Message="{x:Bind DdcBlockedMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                      <Button Content="Talk to it again" Click="OnAllowDdc" Tag="{x:Bind}"
                              ToolTipService.ToolTip="Only if the crash had another cause: if the monitor is at fault, the next capabilities read may crash Windows again."
                              AutomationProperties.Name="AllowDdc"/>
                    </InfoBar.ActionButton>
                  </InfoBar>
                </tk:SettingsCard>
                <tk:SettingsCard ContentAlignment="Vertical"
                                 HorizontalContentAlignment="Stretch"
                                 Header="The monitor's own controls"
                                 Description="{x:Bind MonitorControlsSummary, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9E9;"/>
                  </tk:SettingsCard.HeaderIcon>

                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Show controls" Click="OnToggleMonitorControls"
                              Visibility="{x:Bind MonitorControlsVisibility, Mode=OneWay}"/>
                      <Button Content="Learn a setting…" Click="OnLearnSetting" Tag="{x:Bind}"
                              Visibility="{x:Bind LearnSettingVisibility, Mode=OneWay}"
                              AutomationProperties.Name="LearnSetting"/>
                    </StackPanel>
                  <ItemsControl ItemsSource="{x:Bind MonitorControls}"
                                HorizontalContentAlignment="Stretch"
                                Margin="12,4,0,8" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="2"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MonitorControlViewModel">
                        <Grid ColumnSpacing="16" Padding="0,6,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}"/>
                            <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1" Orientation="Horizontal"
                                      Spacing="12" VerticalAlignment="Center">
                            <Slider Value="{x:Bind Value, Mode=TwoWay}"
                                    Minimum="0" Maximum="{x:Bind Maximum}" StepFrequency="1"
                                    Width="200" VerticalAlignment="Center"
                                    Visibility="{x:Bind SliderVisibility}"
                                    AutomationProperties.Name="{x:Bind Code}"/>
                            <TextBlock Text="{x:Bind ValueText, Mode=OneWay}"
                                       VerticalAlignment="Center" MinWidth="32"
                                       Visibility="{x:Bind SliderVisibility}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox ItemsSource="{x:Bind Options}"
                                      SelectedItem="{x:Bind Selected, Mode=TwoWay}"
                                      MinWidth="200"
                                      Visibility="{x:Bind ChoiceVisibility}"
                                      AutomationProperties.Name="{x:Bind Code}"/>
                            <TextBlock Text="{x:Bind ReadOnlyText}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ReadOnlyVisibility}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Run" Click="{x:Bind ActivateAction}"
                                    Visibility="{x:Bind ActionVisibility}" AutomationProperties.Name="{x:Bind Name}"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Visibility="{x:Bind ModeStatusVisibility, Mode=OneWay}"
                                 ContentAlignment="Vertical">
                  <TextBlock Text="{x:Bind ModeStatus, Mode=OneWay}"
                             Margin="0,0,0,8"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </tk:SettingsCard>
                <!-- The rest of this display, folded until asked for: see Fold. -->
                <tk:SettingsCard Header="{x:Bind AdvancedFold.Label, Mode=OneWay}"
                                 Description="Software dimming, adaptive brightness and rotation, OLED and focus on this display, sleep, variable refresh and colour profile, the work area, controls the monitor did not list, and reset.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleButton IsChecked="{x:Bind AdvancedFold.Open, Mode=TwoWay}" AutomationProperties.Name="{x:Bind AdvancedAutomationName}"
                                ToolTipService.ToolTip="Show or hide the less-used settings">
                    <FontIcon Glyph="{x:Bind AdvancedFold.Glyph, Mode=OneWay}" FontSize="12"/>
                  </ToggleButton>
                </tk:SettingsCard>
                <!-- Only where the real thing is missing. On a panel with a
                     reachable backlight this would be strictly worse: the same
                     light, less contrast. -->
                <tk:SettingsCard Header="Software brightness"
                                 Description="{x:Bind SoftwareBrightnessDescription, Mode=OneWay}"
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, SoftwareBrightnessVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider Value="{x:Bind SoftwareBrightness, Mode=TwoWay}"
                            Minimum="{x:Bind SoftwareBrightnessMinimum, Mode=OneWay}"
                            Maximum="100" StepFrequency="1"
                            Width="220" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind SoftwareBrightnessAutomationName}"/>
                    <TextBlock Text="{x:Bind SoftwareBrightnessText, Mode=OneWay}"
                               VerticalAlignment="Center" MinWidth="40"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </tk:SettingsCard>
                <!-- Windows settings, not the monitor's, but they act on this
                     panel and nothing else: the light sensor drives the
                     built-in backlight and the accelerometer turns the built-in
                     screen. They belong where someone would look for them. -->
                <tk:SettingsCard Header="Adaptive brightness"
                                 Description="{x:Bind AdaptiveDetail, Mode=OneWay}"
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, AdaptiveVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind AdaptiveOn, Mode=TwoWay}"
                                AutomationProperties.Name="AdaptiveBrightnessToggle"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Rotate with the device"
                                 Description="{x:Bind RotationDetail, Mode=OneWay}"
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, RotationVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7AD;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind RotationOn, Mode=TwoWay}"
                                AutomationProperties.Name="AutoRotationToggle"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="OLED panel"
                                 Description="{x:Bind OledSummary, Mode=OneWay}"
                                 Visibility="{x:Bind AdvancedFold.Visibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind IsOled, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind OledAutomationName}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Focus dimming"
                                 Description="Let focus mode dim this display. Off leaves it at full brightness whatever else is happening."
                                 Visibility="{x:Bind AdvancedFold.Visibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE890;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="Same level as all displays" IsChecked="{x:Bind FocusSameAsAll, Mode=TwoWay}" MinWidth="0"
                              VerticalAlignment="Center" IsEnabled="{x:Bind FocusDimming, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind SameFocusAutomationName}"/>
                    <Slider Value="{x:Bind FocusDim, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" Width="140"
                            VerticalAlignment="Center" IsEnabled="{x:Bind FocusOwn, Mode=OneWay}"/>
                    <ToggleSwitch IsOn="{x:Bind FocusDimming, Mode=TwoWay}" AutomationProperties.Name="{x:Bind FocusDimmingAutomationName}"/>
                  </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="OLED burn-in protection"
                                 Description="Whether OLED care's idle and rest settings, on the Screen care page, reach this panel."
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, OledProtectionVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Run screen rest" Click="OnScreenRest" Tag="{x:Bind}"
                            ToolTipService.ToolTip="Blacks this panel now. Move the mouse or press a key to end it early."
                            AutomationProperties.Name="RunOledScreenRest"/>
                    <NumberBox Value="{x:Bind OledRestMinutes, Mode=TwoWay}"
                               Minimum="1" Maximum="30" SmallChange="1" Width="92"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="OledRestMinutes"/>
                    <TextBlock Text="minutes" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch IsOn="{x:Bind OledProtectionEnabled, Mode=TwoWay}" AutomationProperties.Name="OledPanelProtection"/>
                  </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Wake when the pointer returns"
                                 Description="After idle dimming starts, activity on other screens keeps this panel dimmed. Move the pointer onto or within this screen to restore it. The second dimming stage continues while you are away. Applies to idle protection, not manual screen rest."
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, OledProtectionVisibility), Mode=OneWay}">
                  <ToggleSwitch IsOn="{x:Bind OledWakeOnPointerReturn, Mode=TwoWay}"
                                IsEnabled="{x:Bind OledProtectionEnabled, Mode=OneWay}"
                                AutomationProperties.Name="OledWakeOnPointerReturn"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Monitor sleep"
                                 Description="{x:Bind MonitorPowerDescription, Mode=OneWay}"
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, MonitorPowerVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <NumberBox Value="{x:Bind MonitorSleepMinutes, Mode=TwoWay}"
                               Minimum="1" Maximum="240" SmallChange="1" Width="92"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="MonitorSleepMinutes"
                               IsEnabled="{x:Bind MonitorSleepEnabled, Mode=OneWay}"/>
                    <TextBlock Text="minutes idle" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch IsOn="{x:Bind MonitorSleepEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="MonitorSleepEnabled"/>
                  </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Variable refresh rate"
                                 Description="{x:Bind VrrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, VrrVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind VrrEnabled, Mode=TwoWay}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Variable refresh rate"
                                 Description="{x:Bind VrrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, NoVrrVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Not supported" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Colour profile" Description="{x:Bind ColorProfileName, Mode=OneWay}"
                                 Visibility="{x:Bind AdvancedFold.Visibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Manage…" Click="OnColorManagement"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Reclaim the work area"
                                 Description="Let maximised windows fill the whole display. The taskbar appears over them when revealed."
                                 Visibility="{x:Bind AdvancedFold.Visibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9A6;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind ReclaimWorkArea, Mode=TwoWay}"
                                IsEnabled="{x:Bind CanHideTaskbar}"/>
                </tk:SettingsCard>
                <!-- For a monitor that answers no capabilities string: ask it
                     code by code, reading only. -->
                <tk:SettingsCard Header="Look for its controls"
                                 Description="{x:Bind ProbeDescription, Mode=OneWay}"
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, ProbeVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE721;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Forget" Click="OnForgetProbe" Tag="{x:Bind}"
                            Visibility="{x:Bind ForgetProbeVisibility, Mode=OneWay}"
                            AutomationProperties.Name="ForgetProbe"/>
                    <Button Content="Probe (read-only)" Click="OnProbe" Tag="{x:Bind}"
                            IsEnabled="{x:Bind ProbeReady, Mode=OneWay}"
                            AutomationProperties.Name="ProbeMonitor"/>
                  </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Also reported"
                                 Description="{x:Bind UnofferedSummary, Mode=OneWay}"
                                 Visibility="{x:Bind Advanced(AdvancedFold.Open, UnofferedVisibility), Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;"/>
                  </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Reset this display"
                                 Description="Returns DispCtrl's own settings to their defaults. Resolution, refresh rate, HDR and scale belong to Windows and are left alone."
                                 Visibility="{x:Bind AdvancedFold.Visibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE777;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Reset" Click="OnResetDisplay" Tag="{x:Bind}"/>
                </tk:SettingsCard>
              </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

  </Grid>
</Page>
