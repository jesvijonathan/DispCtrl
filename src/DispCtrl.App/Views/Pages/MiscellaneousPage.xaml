<Page x:Class="DispCtrl.App.Views.Pages.MiscellaneousPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      Loaded="OnLoaded">

  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="0" HorizontalAlignment="Stretch">

      <TextBlock Text="Miscellaneous" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="Extras that are not about the displays: Windows' sign-in and lock screen, and a few tools for when Windows needs a nudge."
                 Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Margin="0,4,0,28"/>

      <TextBlock Text="Sign-in and lock screen" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4"/>
      <TextBlock Text="The switches people change with regedit, often on a company laptop. Each shows what Windows has now; machine-wide ones ask for administrator permission when changed, and Put back restores what was there before."
                 Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

      <!-- Rows are built in code from machine get: each reads back what
           Windows has, and the list is one place, MachinePolicies. -->
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"
              BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel x:Name="MachineRows" Spacing="14">
          <ProgressRing IsActive="True" HorizontalAlignment="Left" Width="20" Height="20"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Tools" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,8"/>

      <tk:SettingsCard Header="Refresh the taskbar"
                       Description="Restarts Windows Explorer, which draws the taskbar and desktop, and DispCtrl applies hiding, glass and opacity again. Open File Explorer windows close.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72C;"/></tk:SettingsCard.HeaderIcon>
        <Button Content="Refresh" Click="OnRefreshTaskbar" AutomationProperties.Name="MiscRefreshTaskbar"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Put every display back"
                       Description="What Ctrl+Alt+Backspace does: switches off whatever darkens, tints or hides a screen. Settings, Undo the way back, switches it on again.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE777;"/></tk:SettingsCard.HeaderIcon>
        <Button Content="Put back" Click="OnRestoreNow" AutomationProperties.Name="MiscRestoreNow"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Windows' display settings" Description="Scale, resolution, HDR and night light, in Windows' own Settings.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F8;"/></tk:SettingsCard.HeaderIcon>
        <Button Content="Open" Click="OnOpenWindowsDisplay" AutomationProperties.Name="MiscOpenWindowsDisplay"/>
      </tk:SettingsCard>
      <tk:SettingsCard Header="Colour management" Description="Windows' colour profiles for each display.">
        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;"/></tk:SettingsCard.HeaderIcon>
        <Button Content="Open" Click="OnOpenColourManagement" AutomationProperties.Name="MiscOpenColourManagement"/>
      </tk:SettingsCard>
    </StackPanel>
  </ScrollViewer>
</Page>
