<Page x:Class="DispCtrl.App.Views.TaskbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">

  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="0" HorizontalAlignment="Stretch">

      <StackPanel Spacing="4" Margin="0,0,0,24">
        <TextBlock Text="Taskbar" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="How the auto-hiding taskbars behave. Which monitors hide theirs is set per display, on the Displays page."
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <TextBlock Text="Appearance"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,0,0,8"/>

      <tk:SettingsExpander Header="Taskbar surface" Description="Windows transparency and whole-bar opacity.">
        <Button Content="Restore defaults" Click="OnResetTaskbarSurface" AutomationProperties.Name="ResetTaskbarSurface"/>
        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="Windows transparency" Description="Windows' translucency effect for the taskbar, Start and other system surfaces.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.WindowsTransparency, Mode=TwoWay}" AutomationProperties.Name="TaskbarTransparency"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Aero glass blur"
                           Description="Uses Explorer's compositor and keeps the taskbar icons sharp.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.TaskbarGlassEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" AutomationProperties.Name="TaskbarGlassEnabled"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Blur radius" Description="How far the background is softened behind the taskbar.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.TaskbarGlassRadius, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" Width="160" IsEnabled="{x:Bind ViewModel.TaskbarGlassEnabled, Mode=OneWay}" AutomationProperties.Name="TaskbarGlassRadius"/>
              <TextBlock Text="{x:Bind ViewModel.TaskbarGlassRadius, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="px" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Acrylic tint" Description="Adds a subtle dark tint after the blur.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.TaskbarGlassTint, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" Width="160" IsEnabled="{x:Bind ViewModel.TaskbarGlassEnabled, Mode=OneWay}" AutomationProperties.Name="TaskbarGlassTint"/>
              <TextBlock Text="{x:Bind ViewModel.TaskbarGlassTint, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard ContentAlignment="Left">
            <StackPanel Spacing="8">
              <TextBlock Text="{x:Bind ViewModel.TaskbarGlassStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <Button Content="Restart Windows Explorer" Click="OnRestartExplorer"
                      Visibility="{x:Bind ViewModel.TaskbarGlassRestartVisibility, Mode=OneWay}"
                      AutomationProperties.Name="RestartExplorer"
                      ToolTipService.ToolTip="Windows Explorer still has another DispCtrl build's glass loaded. The taskbar disappears for a moment and open File Explorer windows close."/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Taskbar opacity" Description="100% leaves the taskbar unchanged. Lower values fade the whole bar, including icons. Requires the engine.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Slider Value="{x:Bind ViewModel.TaskbarOpacity, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" Width="160" AutomationProperties.Name="TaskbarOpacity"/>
              <TextBlock Text="{x:Bind ViewModel.TaskbarOpacity, Mode=OneWay}" VerticalAlignment="Center"/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
          </tk:SettingsCard>
          <tk:SettingsCard ContentAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.AppearanceStatus, Mode=OneWay}" TextWrapping="Wrap"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <tk:SettingsExpander Header="Windows taskbar features" Description="Size, alignment, labels, indicators and built-in taskbar buttons.">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Open Windows settings" Click="OnWindowsTaskbar"/>
          <Button Content="Restore defaults" Click="OnResetTaskbarFeatures" AutomationProperties.Name="ResetTaskbarFeatures"/>
        </StackPanel>
        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="Smaller taskbar buttons" Description="Uses Windows' compact button preference. Availability depends on your Windows build.">
            <ComboBox ItemsSource="{x:Bind ViewModel.SmallButtonChoices}" SelectedIndex="{x:Bind ViewModel.SmallTaskbarButtons, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SmallButtonsSupported}" AutomationProperties.Name="SmallTaskbarButtons"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Alignment" Description="Place Start and pinned apps on the left or in the centre.">
            <ComboBox ItemsSource="{x:Bind ViewModel.TaskbarAlignmentChoices}" SelectedIndex="{x:Bind ViewModel.TaskbarAlignment, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Windows11TaskbarSupported}" AutomationProperties.Name="TaskbarAlignment"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Combine buttons and hide labels" Description="Choose how windows from the same app are grouped on the primary taskbar.">
            <ComboBox ItemsSource="{x:Bind ViewModel.TaskbarCombineChoices}" SelectedIndex="{x:Bind ViewModel.TaskbarCombineButtons, Mode=TwoWay}" AutomationProperties.Name="TaskbarCombineButtons"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Combine on other taskbars" Description="Use a separate grouping preference on additional displays.">
            <ComboBox ItemsSource="{x:Bind ViewModel.TaskbarCombineChoices}" SelectedIndex="{x:Bind ViewModel.OtherTaskbarCombineButtons, Mode=TwoWay}" AutomationProperties.Name="OtherTaskbarCombineButtons"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Task View button">
            <ToggleSwitch IsOn="{x:Bind ViewModel.TaskbarShowTaskView, Mode=TwoWay}" AutomationProperties.Name="TaskbarShowTaskView"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Widgets button">
            <ToggleSwitch IsOn="{x:Bind ViewModel.TaskbarShowWidgets, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Windows11TaskbarSupported}" AutomationProperties.Name="TaskbarShowWidgets"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="App badges" Description="Show status counters and indicators on taskbar buttons.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.TaskbarShowBadges, Mode=TwoWay}" AutomationProperties.Name="TaskbarShowBadges"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Flashing apps" Description="Let apps flash their taskbar button when they need attention.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.TaskbarAllowFlashing, Mode=TwoWay}" AutomationProperties.Name="TaskbarAllowFlashing"/>
          </tk:SettingsCard>
          <tk:SettingsCard Header="Show desktop corner" Description="Click the far edge of the taskbar to show the desktop.">
            <ToggleSwitch IsOn="{x:Bind ViewModel.TaskbarShowDesktopCorner, Mode=TwoWay}" AutomationProperties.Name="TaskbarShowDesktopCorner"/>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <TextBlock Text="Reveal behaviour"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <tk:SettingsCard Header="Hide delay"
                       Description="How long the taskbar stays out after the cursor leaves.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE916;"/>
        </tk:SettingsCard.HeaderIcon>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Slider Value="{x:Bind ViewModel.HideDelayMs, Mode=TwoWay}"
                  Minimum="0" Maximum="1500" StepFrequency="50"
                  Width="220" VerticalAlignment="Center"
                  AutomationProperties.Name="HideDelay"/>
          <TextBlock Text="{x:Bind ViewModel.HideDelayMs, Mode=OneWay}"
                     VerticalAlignment="Center" MinWidth="42"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="ms" VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </tk:SettingsCard>

      <tk:SettingsExpander Header="Show and hide animation"
                           Description="Slide the taskbar in and out, or snap it instantly.">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE7C4;"/>
        </tk:SettingsExpander.HeaderIcon>

        <ToggleSwitch IsOn="{x:Bind ViewModel.AnimateTaskbar, Mode=TwoWay}"
                      OnContent="Animate"
                      OffContent="Instant"
                      AutomationProperties.Name="AnimateTaskbar"/>

        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="Slide duration"
                           Description="How long the slide takes.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Slider Value="{x:Bind ViewModel.AnimMs, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.AnimMsEnabled, Mode=OneWay}"
                      Minimum="40" Maximum="500" StepFrequency="10"
                      Width="220" VerticalAlignment="Center"
                      AutomationProperties.Name="SlideDuration"/>
              <TextBlock Text="{x:Bind ViewModel.AnimMs, Mode=OneWay}"
                         VerticalAlignment="Center" MinWidth="42"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="ms" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <tk:SettingsCard Header="Edge sensitivity"
                       Description="How close to the screen edge the cursor must get to reveal the taskbar.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7C9;"/>
        </tk:SettingsCard.HeaderIcon>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Slider Value="{x:Bind ViewModel.RevealPx, Mode=TwoWay}"
                  Minimum="1" Maximum="20" StepFrequency="1"
                  Width="220" VerticalAlignment="Center"
                  AutomationProperties.Name="EdgeSensitivity"/>
          <TextBlock Text="{x:Bind ViewModel.RevealPx, Mode=OneWay}"
                     VerticalAlignment="Center" MinWidth="42"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="px" VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Reset reveal behaviour"
                       Description="Restore the hide delay, animation duration and edge sensitivity.">
        <Button Content="Restore defaults" Click="OnResetTaskbarBehaviour" AutomationProperties.Name="ResetTaskbarBehaviour"/>
      </tk:SettingsCard>

      <TextBlock Text="Responsiveness"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <!-- These were only ever editable by hand in settings.json, which is a
           strange place to keep the knobs that decide how the thing feels. The
           defaults are good; the expander stays shut so they read as the
           advanced settings they are. -->
      <tk:SettingsExpander Header="How often the engine looks at the cursor"
                           Description="{x:Bind ViewModel.PollSummary, Mode=OneWay}">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE9D9;"/>
        </tk:SettingsExpander.HeaderIcon>

        <Button Content="Restore defaults" Click="OnRestorePolling"
                AutomationProperties.Name="RestorePolling"/>

        <tk:SettingsExpander.Items>
          <tk:SettingsCard ContentAlignment="Left">
            <TextBlock TextWrapping="Wrap" MaxWidth="720"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
              Far from any hidden taskbar there is nothing to react to, so the engine
              idles. As the cursor comes within the arm distance it starts looking more
              often, and while a bar is out it looks more often again.
              <LineBreak/><LineBreak/>
              Lower numbers mean a bar that reveals the instant you reach the edge and an
              engine that wakes more; higher numbers mean the opposite. A fast flick from
              the far side of the desk is the case that suffers first.
            </TextBlock>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Arm distance"
                           Description="How near a managed edge the cursor must be before polling speeds up.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Slider Value="{x:Bind ViewModel.ArmDistancePx, Mode=TwoWay}"
                      Minimum="50" Maximum="1000" StepFrequency="25"
                      Width="220" VerticalAlignment="Center"
                      AutomationProperties.Name="ArmDistance"/>
              <TextBlock Text="{x:Bind ViewModel.ArmDistancePx, Mode=OneWay}"
                         VerticalAlignment="Center" MinWidth="42"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="px" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Idle" Description="Nowhere near a managed edge.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Slider Value="{x:Bind ViewModel.IdlePollMs, Mode=TwoWay}"
                      Minimum="20" Maximum="400" StepFrequency="10"
                      Width="220" VerticalAlignment="Center"
                      AutomationProperties.Name="IdlePoll"/>
              <TextBlock Text="{x:Bind ViewModel.IdlePollMs, Mode=OneWay}"
                         VerticalAlignment="Center" MinWidth="42"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="ms" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Far" Description="The longest the engine will ever wait.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Slider Value="{x:Bind ViewModel.FarPollMs, Mode=TwoWay}"
                      Minimum="100" Maximum="2000" StepFrequency="50"
                      Width="220" VerticalAlignment="Center"
                      AutomationProperties.Name="FarPoll"/>
              <TextBlock Text="{x:Bind ViewModel.FarPollMs, Mode=OneWay}"
                         VerticalAlignment="Center" MinWidth="42"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="ms" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Armed" Description="Inside the arm distance. This one decides how quick the reveal feels.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Slider Value="{x:Bind ViewModel.ArmedPollMs, Mode=TwoWay}"
                      Minimum="8" Maximum="100" StepFrequency="4"
                      Width="220" VerticalAlignment="Center"
                      AutomationProperties.Name="ArmedPoll"/>
              <TextBlock Text="{x:Bind ViewModel.ArmedPollMs, Mode=OneWay}"
                         VerticalAlignment="Center" MinWidth="42"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="ms" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Shown" Description="While a taskbar is out, watching for the cursor to leave.">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Slider Value="{x:Bind ViewModel.ShownPollMs, Mode=TwoWay}"
                      Minimum="10" Maximum="200" StepFrequency="5"
                      Width="220" VerticalAlignment="Center"
                      AutomationProperties.Name="ShownPoll"/>
              <TextBlock Text="{x:Bind ViewModel.ShownPollMs, Mode=OneWay}"
                         VerticalAlignment="Center" MinWidth="42"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="ms" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <TextBlock Text="Primary taskbar"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <!-- The honest answer to "why can't I hide the primary one?". DispCtrl
           cannot move it, but Windows can — at a cost worth stating up front. -->
      <tk:SettingsExpander Header="Use Windows' own auto-hide"
                           Description="The only way to hide the primary monitor's taskbar.">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE7C4;"/>
        </tk:SettingsExpander.HeaderIcon>

        <ToggleSwitch IsOn="{x:Bind ViewModel.GlobalAutoHide, Mode=TwoWay}"
                      AutomationProperties.Name="GlobalAutoHide"/>

        <tk:SettingsExpander.Items>
          <tk:SettingsCard ContentAlignment="Left">
            <TextBlock TextWrapping="Wrap" MaxWidth="720"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
              DispCtrl cannot move the primary taskbar: the call reports success and
              Explorer restores it within about 120 milliseconds. Windows' own auto-hide
              can, because Explorer is the one doing the hiding.
              <LineBreak/><LineBreak/>
              Two things to know before turning it on. It is a single global switch, so it
              auto-hides every taskbar, not just the primary one. And it leaves a
              one-pixel strip lit along the edge, because Explorer needs that strip to
              catch the hover — which is precisely the burn-in risk DispCtrl's own hiding
              exists to avoid.
              <LineBreak/><LineBreak/>
              DispCtrl keeps managing every other monitor itself. Where you have enabled
              hiding on a display, DispCtrl parks that taskbar fully off the panel as usual
              and overrides Windows' sliver — so this switch effectively applies to the
              primary display only.
              <LineBreak/><LineBreak/>
              So this is the right choice when your primary display is not the one at
              risk, and the wrong one when it is an OLED panel.
            </TextBlock>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

    </StackPanel>
  </ScrollViewer>
</Page>
