<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <AssemblyName>DispCtrl.App</AssemblyName>
    <RootNamespace>DispCtrl.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- So the exe carries the icon itself. Without it a pinned shortcut, the
         taskbar button and alt-tab all show the generic .NET icon, and setting
         it on the shortcut alone fixes only the first of the three. -->
    <ApplicationIcon>Assets\DispCtrl.ico</ApplicationIcon>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Unpackaged while developing. The MSIX build sets this back so the app
         runs with package identity and can register its startup task. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Compiled bindings only. x:Bind resolves at compile time, which keeps
         the UI honest about what it depends on and leaves the door open for
         AOT later; reflection-based Binding would close it. -->
    <WinUIXamlOptimization>true</WinUIXamlOptimization>

    <!-- LibraryImport's generated marshalling is unsafe code. Required for
         SendInput, which is the only way to raise a shell flyout. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DispCtrl.Control\DispCtrl.Control.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- The metapackage carries machine learning (onnxruntime, DirectML), the
         AI APIs, Widgets and Search: ~45 MB of every release, none of it used.
         The toolkit below depends on the metapackage, so it cannot be swapped
         for components; these override its transitive assets instead. Versions
         are the metapackage's own: bump them with it. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />

    <!-- SettingsCard / SettingsExpander: the same controls Windows 11 Settings
         and PowerToys use. Worth the dependency — hand-rolling them is how an
         app ends up looking almost-but-not-quite native. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DispCtrl.Core\DispCtrl.Core.csproj" />
    <ProjectReference Include="..\DispCtrl.Display\DispCtrl.Display.csproj" />
  </ItemGroup>

  <!-- The release bundle: one trimmed runtime for the app, the engine and the
       command line, which share a folder. Trimming each on its own would leave
       three different copies of every framework DLL fighting over one file
       name, so the app references the other two and the trimmer keeps what
       all three use. Partial: only assemblies marked trimmable are cut;
       DispCtrl.Display (WMI, P/Invoke) and the executables are kept whole.
       Built-in COM stays on - WMI brightness is built-in COM, and the trimmer
       would otherwise remove it from the runtime the engine shares.
       Publish.ps1 sets DispCtrlBundle; a plain build is unchanged. -->
  <PropertyGroup Condition="'$(DispCtrlBundle)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- System.Management, the WinRT projection and built-in COM reflect over
         what they use, so the trimmer warns about them; they are kept whole or
         rooted, and the published bundle is run before it ships (Publish.ps1). -->
    <!-- CsWinRT's generator writes the WinRT interop the app's own types need as
         code the trimmer can see. Not enough on its own for a type derived from
         a WinUI class: those also need Trimming.xml (TRAPS.md, Build). -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup Condition="'$(DispCtrlBundle)' == 'true'">
    <ProjectReference Include="..\DispCtrl.Engine\DispCtrl.Engine.csproj" />
    <ProjectReference Include="..\DispCtrl.Cli\DispCtrl.Cli.csproj" />
    <!-- Marked trimmable, but WMI creates its COM classes by reflection: cut,
         every brightness read on the built-in panel failed with "no
         parameterless constructor" for WbemDefPath. Kept whole. -->
    <TrimmerRootDescriptor Include="Trimming.xml" />
    <TrimmerRootAssembly Include="System.Management" />
    <TrimmerRootAssembly Include="System.CodeDom" />
  </ItemGroup>

  <!-- The UPI QR on the About page. One file, shared with the website and the
       README, copied beside the executable rather than duplicated here. -->
  <ItemGroup>
    <Content Include="..\..\site\assets\donations\upi-qr.png" Link="Assets\upi-qr.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
