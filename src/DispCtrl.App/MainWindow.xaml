<Window x:Class="DispCtrl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DispCtrl.App.Views.Controls"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

  <!-- Mica is what makes a window read as part of Windows 11 rather than as an
       app drawn on top of it: it tints with the desktop behind and with the
       system theme, for free. -->
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt"/>
  </Window.SystemBackdrop>

  <Grid RowDefinitions="Auto,*">

    <!-- Navigation occupies the next row, so the title needs only the normal
         window-edge padding. -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="44" ColumnDefinitions="Auto,Auto,*">
      <TextBlock x:Name="AppTitle" Text="DispCtrl" Margin="16,0,0,0"
                 AutomationProperties.AutomationId="ApplicationTitle"
                 VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}"/>

      <!-- The preset in use, on every page, the way a browser shows its
           profile: which one the desk is compared against, a dot when the
           desk has moved from it, and everything else one press away. The
           title bar is a drag region, so this button's rectangle is handed
           back to the window as pass-through (UpdateTitleBarPassthrough). -->
      <Button x:Name="PresetSwitcher" Grid.Column="1" Margin="16,0,0,0" Padding="10,3,8,4"
              VerticalAlignment="Center" MinHeight="28"
              Background="Transparent" BorderThickness="0"
              SizeChanged="OnPresetSwitcherSizeChanged"
              AutomationProperties.Name="PresetSwitcher"
              ToolTipService.ToolTip="{x:Bind ViewModel.Presets.DriftTooltip, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE74E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="{x:Bind ViewModel.Presets.SwitcherText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                     VerticalAlignment="Center"/>
          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                   Fill="{ThemeResource SystemFillColorCautionBrush}"
                   Visibility="{x:Bind ViewModel.Presets.NoticeVisibility, Mode=OneWay}"/>
          <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnPresetFlyoutOpening">
            <StackPanel Spacing="10" Width="320">
              <TextBlock Text="Preset" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="The desk is compared with the preset chosen here. Choosing one changes nothing; Apply puts the desk back to it."/>
              <!-- The list's last entry starts a new preset, so creating one is
                   reachable from the same control that switches between them. -->
              <ComboBox ItemsSource="{x:Bind ViewModel.Presets.Names}"
                        SelectedItem="{x:Bind ViewModel.Presets.Selected, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="SwitcherPresetPicker"/>
              <TextBox Text="{x:Bind ViewModel.Presets.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="Name"
                       Visibility="{x:Bind ViewModel.Presets.CreatingVisibility, Mode=OneWay}"
                       AutomationProperties.Name="SwitcherPresetName"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <views:PresetChanges VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.Presets.ShortStatus, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Apply" Click="OnPresetApply"
                        ToolTipService.ToolTip="Put the displays back to this preset"
                        Visibility="{x:Bind ViewModel.Presets.ActionVisibility, Mode=OneWay}"
                        AutomationProperties.Name="SwitcherPresetApply"/>
                <Button Content="Save" Click="OnPresetSave" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Update this preset to match the displays"
                        Visibility="{x:Bind ViewModel.Presets.ActionVisibility, Mode=OneWay}"
                        AutomationProperties.Name="SwitcherPresetSave"/>
                <Button Content="Create" Click="OnPresetSave" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.Presets.CreatingVisibility, Mode=OneWay}"
                        AutomationProperties.Name="SwitcherPresetCreate"/>
              </StackPanel>
              <HyperlinkButton Content="All presets and app rules" Click="OnManagePresets" Padding="0"/>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <muxc:NavigationView x:Name="Nav"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         PaneTitle="Menu"
                         IsPaneToggleButtonVisible="True"
                         CompactModeThresholdWidth="0"
                         ExpandedModeThresholdWidth="1100"
                         IsBackButtonVisible="Collapsed"
                         IsTitleBarAutoPaddingEnabled="False"
                         OpenPaneLength="220"
                         SelectionChanged="OnNavigationSelectionChanged"
                         ItemInvoked="OnNavigationItemInvoked">

      <muxc:NavigationView.MenuItems>
        <muxc:NavigationViewItem Content="Displays" Tag="displays" IsSelected="True">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7F4;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Brightness" Tag="brightness">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE706;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Screen care" Tag="care">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE890;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Windows" Tag="windows">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE737;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Taskbar" Tag="taskbar">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7C4;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem x:Name="PresetsNavigation" Content="Presets" Tag="presets">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE74E;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Quick panel" Tag="quickpanel">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE71D;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Hotkeys" Tag="hotkeys">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE765;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Devices" Tag="devices">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9F9;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Miscellaneous" Tag="misc">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE712;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

      </muxc:NavigationView.MenuItems>

      <muxc:NavigationView.FooterMenuItems>
        <!-- Opens the website's support section (GitHub Sponsors, PayPal, UPI) in
             the browser; not a page of its own, so it
             never takes the selection away from the page being read. -->
        <muxc:NavigationViewItem Content="Sponsor DispCtrl" Tag="sponsor" SelectsOnInvoked="False"
                                 ToolTipService.ToolTip="DispCtrl is free and open source. GitHub Sponsors, PayPal or UPI: donations pay for development and test hardware."
                                 AutomationProperties.Name="Sponsor DispCtrl">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xEB52;" Foreground="#DB61A2"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Help" Tag="help">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE897;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="About" Tag="about">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE946;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
      </muxc:NavigationView.FooterMenuItems>

      <!-- Page content owns the status bar, so the navigation pane continues
           all the way to the bottom instead of being cut off by it. -->
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0">
        <!-- One line, shown only while the desk differs from the preset in use,
             on any page. An InfoBar put its content on a second row, which
             made a notice taller than the page header it sat over. The count
             is the button that lists the changes. Closed by hand, it stays
             away until the desk moves again. -->
        <Border x:Name="PresetDriftBanner" Visibility="Collapsed"
                Margin="12,6,12,2" Padding="12,4,4,4" CornerRadius="6"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                AutomationProperties.Name="PresetDriftBanner">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <FontIcon Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="PresetDriftText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Style="{StaticResource BodyTextBlockStyle}"/>
              <Button x:Name="PresetDriftCount" Padding="4,2" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      ToolTipService.ToolTip="See what has changed"
                      AutomationProperties.Name="BannerPresetChanges">
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <views:PresetChangesList/>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Content="Discard" Click="OnPresetApply" Padding="10,3"
                      ToolTipService.ToolTip="Put the displays back to this preset"
                      AutomationProperties.Name="BannerPresetDiscard"/>
              <Button Content="Save" Click="OnPresetSave" Padding="10,3" Style="{StaticResource AccentButtonStyle}"
                      ToolTipService.ToolTip="Update this preset to match the displays"
                      AutomationProperties.Name="BannerPresetSave"/>
              <Button Click="OnPresetBannerClose" Padding="8,6" Background="Transparent" BorderThickness="0"
                      ToolTipService.ToolTip="Hide until the displays change again"
                      AutomationProperties.Name="BannerPresetClose">
                <FontIcon Glyph="&#xE711;" FontSize="11"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- The occasional request for support (SupportPrompt): one line, like
             the preset banner above it, never on a first run. -->
        <Border x:Name="SupportBanner" Visibility="Collapsed"
                Margin="12,6,12,2" Padding="12,4,4,4" CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                AutomationProperties.Name="SupportBanner">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <FontIcon Glyph="&#xEB52;" FontSize="14" VerticalAlignment="Center" Foreground="#DB61A2"/>
            <TextBlock x:Name="SupportText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Finding DispCtrl useful? It is free and made in spare time. A star helps others find it; a donation pays for monitors to test on."
                       ToolTipService.ToolTip="Finding DispCtrl useful? It is free and made in spare time. A star helps others find it; a donation pays for monitors to test on."/>
            <StackPanel x:Name="SupportActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Click="OnSupportStar" Padding="10,3" AutomationProperties.Name="SupportStar">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE734;" FontSize="12"/>
                  <TextBlock Text="Star on GitHub"/>
                </StackPanel>
              </Button>
              <Button Content="Sponsor" Click="OnSupportSponsor" Padding="10,3" Style="{StaticResource AccentButtonStyle}"
                      ToolTipService.ToolTip="GitHub Sponsors, PayPal or UPI" AutomationProperties.Name="SupportSponsor"/>
              <Button Click="OnSupportClose" Padding="8,6" Background="Transparent" BorderThickness="0"
                      ToolTipService.ToolTip="Not now" AutomationProperties.Name="SupportClose">
                <FontIcon Glyph="&#xE711;" FontSize="11"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        </StackPanel>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>

        <Border Grid.Row="2" Padding="16,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Engine" Style="{StaticResource CaptionTextBlockStyle}"/>
              <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="{x:Bind ViewModel.EngineStateText, Mode=OneWay}"
                         AutomationProperties.AutomationId="EngineStatus"
                         AutomationProperties.LiveSetting="Polite"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Grid Grid.ColumnSpan="3" ColumnDefinitions="Auto,Auto" ColumnSpacing="8"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="130,0" IsHitTestVisible="False">
              <ProgressRing Width="14" Height="14"
                            IsActive="{x:Bind ViewModel.FooterBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.FooterBusyVisibility, Mode=OneWay}"/>
              <TextBlock Grid.Column="1"
                         Text="{x:Bind ViewModel.FooterStatus, Mode=OneWay}"
                         TextTrimming="CharacterEllipsis" MaxWidth="340"
                         AutomationProperties.AutomationId="FooterStatus"
                         AutomationProperties.LiveSetting="Polite"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         VerticalAlignment="Center"/>
            </Grid>
            <ToggleSwitch Grid.Column="2"
                          IsOn="{x:Bind ViewModel.EngineRunning, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.CanToggleEngine}"
                          OnContent="" OffContent="" MinWidth="0"
                          HorizontalAlignment="Right"
                          AutomationProperties.AutomationId="EngineToggle"
                          AutomationProperties.Name="Engine"
                          ToolTipService.ToolTip="Start or stop the background engine"
                          Toggled="OnEngineToggled"/>
          </Grid>
        </Border>
      </Grid>
    </muxc:NavigationView>
  </Grid>
</Window>
