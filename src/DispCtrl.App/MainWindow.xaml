<Window x:Class="DispCtrl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

  <!-- Mica is what makes a window read as part of Windows 11 rather than as an
       app drawn on top of it: it tints with the desktop behind and with the
       system theme, for free. -->
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt"/>
  </Window.SystemBackdrop>

  <Grid RowDefinitions="Auto,*">

    <!-- Navigation occupies the next row, so the title needs only the normal
         window-edge padding. -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="44" ColumnDefinitions="Auto,*">
      <TextBlock Text="DispCtrl" Margin="16,0,0,0"
                 AutomationProperties.AutomationId="ApplicationTitle"
                 VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}"/>
    </Grid>

    <muxc:NavigationView x:Name="Nav"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         PaneTitle="Menu"
                         IsPaneToggleButtonVisible="True"
                         CompactModeThresholdWidth="0"
                         ExpandedModeThresholdWidth="1100"
                         IsBackButtonVisible="Collapsed"
                         IsTitleBarAutoPaddingEnabled="False"
                         OpenPaneLength="220"
                         SelectionChanged="OnNavigationSelectionChanged">

      <muxc:NavigationView.MenuItems>
        <muxc:NavigationViewItem Content="Displays" Tag="displays" IsSelected="True">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7F4;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Taskbar" Tag="taskbar">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7C4;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem x:Name="PresetsNavigation" Content="Presets" Tag="presets">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE74E;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Quick panel" Tag="quickpanel">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE71D;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Hotkeys" Tag="hotkeys">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE765;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Devices" Tag="devices">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9F9;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

      </muxc:NavigationView.MenuItems>

      <muxc:NavigationView.FooterMenuItems>
        <muxc:NavigationViewItem Content="Help" Tag="help">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE897;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="About" Tag="about">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE946;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
      </muxc:NavigationView.FooterMenuItems>

      <!-- Page content owns the status bar, so the navigation pane continues
           all the way to the bottom instead of being cut off by it. -->
      <Grid RowDefinitions="*,Auto">
        <Frame x:Name="ContentFrame"/>

        <Border Grid.Row="1" Padding="16,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Engine" Style="{StaticResource CaptionTextBlockStyle}"/>
              <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="{x:Bind ViewModel.EngineStateText, Mode=OneWay}"
                         AutomationProperties.AutomationId="EngineStatus"
                         AutomationProperties.LiveSetting="Polite"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Grid Grid.ColumnSpan="3" ColumnDefinitions="Auto,Auto" ColumnSpacing="8"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="130,0" IsHitTestVisible="False">
              <ProgressRing Width="14" Height="14"
                            IsActive="{x:Bind ViewModel.FooterBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.FooterBusyVisibility, Mode=OneWay}"/>
              <TextBlock Grid.Column="1"
                         Text="{x:Bind ViewModel.FooterStatus, Mode=OneWay}"
                         TextTrimming="CharacterEllipsis" MaxWidth="340"
                         AutomationProperties.AutomationId="FooterStatus"
                         AutomationProperties.LiveSetting="Polite"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         VerticalAlignment="Center"/>
            </Grid>
            <ToggleSwitch Grid.Column="2"
                          IsOn="{x:Bind ViewModel.EngineRunning, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.CanToggleEngine}"
                          OnContent="" OffContent="" MinWidth="0"
                          HorizontalAlignment="Right"
                          AutomationProperties.AutomationId="EngineToggle"
                          AutomationProperties.Name="Engine"
                          ToolTipService.ToolTip="Start or stop the background engine"
                          Toggled="OnEngineToggled"/>
          </Grid>
        </Border>
      </Grid>
    </muxc:NavigationView>
  </Grid>
</Window>
