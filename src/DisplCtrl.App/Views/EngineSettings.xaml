<UserControl x:Class="DisplCtrl.App.Views.EngineSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tk="using:CommunityToolkit.WinUI.Controls">
  <StackPanel Spacing="0">
    <TextBlock Text="Engine" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,8"/>
    <tk:SettingsCard Header="{x:Bind ViewModel.EngineStateText, Mode=OneWay}"
                     Description="{x:Bind ViewModel.EngineDetailText, Mode=OneWay}">
      <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;"/></tk:SettingsCard.HeaderIcon>
    </tk:SettingsCard>

    <tk:SettingsExpander Header="Engine files" Description="Settings, diagnostics and the background executable.">
      <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8A5;"/></tk:SettingsExpander.HeaderIcon>
      <tk:SettingsExpander.Items>
        <tk:SettingsCard Header="Settings file" Description="{x:Bind ViewModel.SettingsPath}">
          <Button Content="Show in folder" Click="OnOpenSettingsFolder"/>
        </tk:SettingsCard>
        <tk:SettingsCard Header="Log" Description="{x:Bind ViewModel.LogPath}">
          <Button Content="Open log" Click="OnOpenLog"/>
        </tk:SettingsCard>
        <tk:SettingsCard Header="Executable" Description="{x:Bind ViewModel.EnginePath}"/>
      </tk:SettingsExpander.Items>
    </tk:SettingsExpander>
  </StackPanel>
</UserControl>
