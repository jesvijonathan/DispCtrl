<Window x:Class="DisplCtrl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

  <!-- Mica is what makes a window read as part of Windows 11 rather than as an
       app drawn on top of it: it tints with the desktop behind and with the
       system theme, for free. -->
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt"/>
  </Window.SystemBackdrop>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Navigation occupies the next row, so the title needs only the normal
         window-edge padding. -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="44" ColumnDefinitions="Auto,*">
      <TextBlock Text="DisplCtrl" Margin="16,0,0,0"
                 AutomationProperties.AutomationId="ApplicationTitle"
                 VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}"/>
    </Grid>

    <muxc:NavigationView x:Name="Nav"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         PaneTitle="Menu"
                         IsPaneToggleButtonVisible="True"
                         CompactModeThresholdWidth="0"
                         ExpandedModeThresholdWidth="1100"
                         IsBackButtonVisible="Collapsed"
                         IsTitleBarAutoPaddingEnabled="False"
                         OpenPaneLength="220"
                         SelectionChanged="OnNavigationSelectionChanged">

      <muxc:NavigationView.MenuItems>
        <muxc:NavigationViewItem Content="Displays" Tag="displays" IsSelected="True">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7F4;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Taskbar" Tag="taskbar">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7C4;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem x:Name="PresetsNavigation" Content="Presets" Tag="presets">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8FD;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Hotkeys" Tag="hotkeys">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE765;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

      </muxc:NavigationView.MenuItems>

      <muxc:NavigationView.FooterMenuItems>
        <muxc:NavigationViewItem Content="Help" Tag="help">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE897;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="About" Tag="about">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE946;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
      </muxc:NavigationView.FooterMenuItems>

      <Frame x:Name="ContentFrame"/>
    </muxc:NavigationView>

    <!-- Outside the page and navigation scroll regions: visible at every
         window width, including when the navigation pane is collapsed. -->
    <Border Grid.Row="2" Padding="16,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Engine" Style="{StaticResource CaptionTextBlockStyle}"/>
          <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="{x:Bind ViewModel.EngineStateText, Mode=OneWay}"
                     AutomationProperties.AutomationId="EngineStatus"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Grid Grid.Column="1">
          <Button Content="Start" MinWidth="72"
                  AutomationProperties.AutomationId="StartEngine"
                  AutomationProperties.Name="Start engine"
                  ToolTipService.ToolTip="Start the background engine"
                  Style="{StaticResource AccentButtonStyle}"
                  Visibility="{x:Bind ViewModel.StartVisibility, Mode=OneWay}"
                  IsEnabled="{x:Bind ViewModel.CanToggleEngine}"
                  Click="OnToggleEngine"/>
          <Button Content="Stop" MinWidth="72"
                  AutomationProperties.AutomationId="StopEngine"
                  AutomationProperties.Name="Stop engine"
                  ToolTipService.ToolTip="Stop the background engine"
                  Visibility="{x:Bind ViewModel.StopVisibility, Mode=OneWay}"
                  Click="OnToggleEngine"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
