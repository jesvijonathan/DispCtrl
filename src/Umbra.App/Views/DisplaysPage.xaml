<Page x:Class="Umbra.App.Views.DisplaysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:vm="using:Umbra.App.ViewModels"
      xmlns:views="using:Umbra.App.Views"
      Loaded="OnLoaded">

  <Page.Resources>
    <!-- One style for every label in the information grid, so the block reads
         as a table rather than as a pile of individually styled text. -->
    <Style x:Key="InfoLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="InfoValue" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="IsTextSelectionEnabled" Value="True"/>
    </Style>
  </Page.Resources>

  <ScrollViewer Padding="0,0,0,32">
    <!-- Stretch with no MaxWidth. The cap was the problem: a Stretch panel
           with a MaxWidth centres itself once the window exceeds that width,
           which is what pushed content off to one side. Pinning it Left instead
           fixed the drift but made the panel size to its content, so cards
           stopped filling. Filling at every width is what Windows Settings
           does, and the side padding already keeps line length sane. -->
      <StackPanel Padding="36,12,36,0" Spacing="0"
                  HorizontalAlignment="Stretch">

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Displays" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="{x:Bind ViewModel.TopologyText, Mode=OneWay}"
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Button Grid.Column="1" Click="OnRescan"
                VerticalAlignment="Bottom" Width="40" Height="36" Padding="0"
                ToolTipService.ToolTip="Rescan displays"
                AutomationProperties.Name="Rescan displays">
          <FontIcon Glyph="&#xE72C;" FontSize="16"/>
        </Button>
      </Grid>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
               Visibility="{x:Bind ViewModel.InactiveVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.InactiveText, Mode=OneWay}"/>

      <!-- The same four choices as Win+P, applied through the documented
           topology flags so Windows reuses the arrangement you last had. -->
      <tk:SettingsCard Header="Multiple displays"
                       Description="How the desktop is spread across your monitors.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7F4;"/>
        </tk:SettingsCard.HeaderIcon>
        <ComboBox ItemsSource="{x:Bind ViewModel.Arrangements}"
                  SelectedItem="{x:Bind ViewModel.SelectedArrangement, Mode=TwoWay}"
                  MinWidth="240"/>
      </tk:SettingsCard>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Margin="0,4,0,0"
               Visibility="{x:Bind ViewModel.ArrangementStatusVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.ArrangementStatus, Mode=OneWay}"/>

      <tk:SettingsCard Header="Detect displays"
                       Description="Identify shows each display&apos;s number on the screen itself. Detect re-scans, including monitors connected but switched off.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE71E;"/>
        </tk:SettingsCard.HeaderIcon>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Identify" Click="OnIdentify"/>
          <Button Content="Detect" Click="OnDetect"/>
        </StackPanel>
      </tk:SettingsCard>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,4,0,0"
               Visibility="{x:Bind ViewModel.DetectStatusVisibility, Mode=OneWay}"
               Message="{x:Bind ViewModel.DetectStatus, Mode=OneWay}"/>

      <tk:SettingsCard Header="Connect to a wireless display"
                       Description="Opens Windows' own pairing flow — Miracast discovery and PIN entry belong there.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7F7;"/>
        </tk:SettingsCard.HeaderIcon>
        <Button Content="Connect" Click="OnConnectWireless"/>
      </tk:SettingsCard>

      <!-- Deliberately not a SettingsCard. That control reserves a header
           gutter and places content in its right-hand action area whatever
           ContentAlignment says, so a wide child ends up stranded in a narrow
           column — glaring once the window is maximised. A plain header plus a
           full-width block is what actually spans. -->
      <StackPanel Margin="0,4,0,0" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <FontIcon Glyph="&#xE80A;" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Arrange displays"/>
            <TextBlock Text="Drag a display to match where it physically sits. Nothing changes until you apply."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>
        <views:ArrangeCanvas x:Name="ArrangeSurface" Margin="0,4,0,4"/>
      </StackPanel>

      <tk:SettingsExpander Header="Unison brightness"
                           Description="One control for every display, relative to the level each is already at.">
        <tk:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE706;"/>
        </tk:SettingsExpander.HeaderIcon>

        <ToggleSwitch IsOn="{x:Bind ViewModel.UnisonBrightness, Mode=TwoWay}"
                      AutomationProperties.Name="UnisonBrightnessToggle"/>

        <tk:SettingsExpander.Items>
          <tk:SettingsCard Header="Level"
                           Description="{x:Bind ViewModel.UnisonLevelDescription, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.UnisonVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Slider Value="{x:Bind ViewModel.UnisonLevel, Mode=TwoWay}"
                      Minimum="{x:Bind ViewModel.UnisonMinimum, Mode=OneWay}"
                      Maximum="100" StepFrequency="1"
                      Width="240" VerticalAlignment="Center"
                      AutomationProperties.Name="UnisonLevelSlider"/>
              <TextBlock Text="{x:Bind ViewModel.UnisonLevel, Mode=OneWay}"
                         VerticalAlignment="Center" MinWidth="32"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="%" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </tk:SettingsCard>

          <!-- Calibration is a walkthrough rather than two number boxes: the
               limits are a judgement made by looking at the panels side by
               side, which no amount of typing reproduces. -->
          <tk:SettingsCard Header="Use captured limits"
                           Description="Ask each display how dim and how bright it should go, then run the slider between those levels instead of scaling one captured value."
                           Visibility="{x:Bind ViewModel.UnisonVisibility, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE9E9;"/>
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.UnisonCalibrated, Mode=TwoWay}"
                          AutomationProperties.Name="UnisonCalibratedToggle"/>
          </tk:SettingsCard>

          <tk:SettingsCard Header="{x:Bind ViewModel.CalibrationHeader, Mode=OneWay}"
                           Description="{x:Bind ViewModel.CalibrationPrompt, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.CalibrationStepVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{x:Bind ViewModel.CalibrationButtonText, Mode=OneWay}"
                      Style="{StaticResource AccentButtonStyle}"
                      Click="OnCaptureLimits"
                      AutomationProperties.Name="CaptureLimitButton"/>
              <Button Content="Cancel" Click="OnCancelCalibration"/>
            </StackPanel>
          </tk:SettingsCard>

          <tk:SettingsCard Header="Captured limits"
                           Description="{x:Bind ViewModel.CalibrationSummary, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.RecalibrateVisibility, Mode=OneWay}">
            <Button Content="Calibrate again" Click="OnRecalibrate"
                    AutomationProperties.Name="RecalibrateButton"/>
          </tk:SettingsCard>

          <!-- The slider is a multiplier, so its own number says nothing about
               where any given panel ended up. This does. -->
          <tk:SettingsCard Header="Each display now"
                           Description="{x:Bind ViewModel.BrightnessSummary, Mode=OneWay}">
            <tk:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7F4;"/>
            </tk:SettingsCard.HeaderIcon>
          </tk:SettingsCard>
        </tk:SettingsExpander.Items>
      </tk:SettingsExpander>

      <TextBlock Text="Each display"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Displays, Mode=OneWay}">
        <ItemsRepeater.Layout>
          <StackLayout Spacing="4"/>
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:DisplayViewModel">

            <tk:SettingsExpander Header="{x:Bind Name}" Description="{x:Bind Details}">
              <tk:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE7F4;"/>
              </tk:SettingsExpander.HeaderIcon>

              <TextBlock Text="{x:Bind SummaryLine, Mode=OneWay}"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

              <tk:SettingsExpander.Items>

                <!-- Information first.
                     SettingsCard keeps its icon/header gutter even with
                     ContentAlignment="Vertical", so content is always indented
                     past it. Rather than fight that, the card is given a real
                     header: the content then aligns under the header text,
                     which is how Windows Settings lays out an expanded card —
                     deliberate rather than a gap. -->
                <tk:SettingsCard ContentAlignment="Vertical"
                                 HorizontalContentAlignment="Stretch">
                  <Grid ColumnSpacing="28" Padding="0,4,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Facts, as a table. Explicitly stretched and left
                         aligned so the block starts at the card edge instead
                         of floating in the middle with dead space beside it. -->
                    <Grid Grid.Column="1" ColumnSpacing="16" RowSpacing="9"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Active signal mode" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ActiveSignalMode, Mode=OneWay}" Style="{StaticResource InfoValue}"/>

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Desktop mode" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind DesktopModeText, Mode=OneWay}" Style="{StaticResource InfoValue}"/>

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Bit depth" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind BitDepth, Mode=OneWay}" Style="{StaticResource InfoValue}"/>

                      <TextBlock Grid.Row="4" Grid.Column="0" Text="Colour format" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ColorFormat, Mode=OneWay}" Style="{StaticResource InfoValue}"/>

                      <TextBlock Grid.Row="5" Grid.Column="0" Text="Colour space" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ColorSpace, Mode=OneWay}" Style="{StaticResource InfoValue}"/>

                      <TextBlock Grid.Row="6" Grid.Column="0" Text="HDR status" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind HdrStatus, Mode=OneWay}" Style="{StaticResource InfoValue}"/>

                      <TextBlock Grid.Row="7" Grid.Column="0" Text="Scan type" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ScanLineOrdering, Mode=OneWay}" Style="{StaticResource InfoValue}"/>

                      <TextBlock Grid.Row="8" Grid.Column="0" Text="Pixel clock" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind PixelClock, Mode=OneWay}" Style="{StaticResource InfoValue}"/>

                      <TextBlock Grid.Row="9" Grid.Column="0" Text="Identity" Style="{StaticResource InfoLabel}"/>
                      <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind Token}"
                                 Style="{StaticResource InfoValue}"
                                 FontFamily="Consolas"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <!-- The panel itself, drawn at its real aspect ratio with
                         its own wallpaper in it — the same idea as the preview
                         in Windows' Display settings. -->
                    <!-- Left-aligned explicitly: an element with an explicit Width
                         inside a StackPanel centres itself when alignment is
                         left at the default Stretch. -->
                    <StackPanel Grid.Column="0" Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                      <Border Width="{x:Bind PreviewWidth}"
                              Height="{x:Bind PreviewHeight}"
                              HorizontalAlignment="Left"
                              CornerRadius="6"
                              BorderThickness="2"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <Grid>
                          <Image Source="{x:Bind WallpaperImage, Mode=OneWay}"
                                 Stretch="UniformToFill"
                                 Visibility="{x:Bind HasWallpaper, Mode=OneWay}"/>
                          <!-- A dark wallpaper left the tile looking like an
                               empty box. A scrim plus the number keeps it
                               legible whatever is behind it. -->
                          <Border Background="#40000000"/>
                          <Border Background="#B21F1F1F"
                                  CornerRadius="8"
                                  Width="46" Height="46"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Number}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="24" FontWeight="SemiBold"
                                       Foreground="White"/>
                          </Border>
                        </Grid>
                      </Border>

                      <TextBlock Text="{x:Bind PreviewCaption}"
                                 HorizontalAlignment="Center"
                                 Style="{StaticResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                  </Grid>
                </tk:SettingsCard>

                <!-- Then wallpaper, then brightness, then the rest. -->
                <tk:SettingsCard Header="Wallpaper" Description="{x:Bind WallpaperName, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Change…" Click="OnPickWallpaper" Tag="{x:Bind}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Fit"
                                 Description="How the image is scaled to the screen. Windows applies the fit mode to every display.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9A6;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind WallpaperFits}"
                            SelectedItem="{x:Bind SelectedWallpaperFit, Mode=TwoWay}"
                            MinWidth="140"/>
                </tk:SettingsCard>

                <!-- Wrapped in a card, not placed bare. SettingsExpander.Items
                     only accepts card-like children; a raw InfoBar here takes
                     the process down when the expander realises its content. -->
                <tk:SettingsCard ContentAlignment="Vertical"
                                 Visibility="{x:Bind SystemWideWallpaperNotice}">
                  <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                           HorizontalAlignment="Stretch" Margin="0,0,0,8"
                           Message="Per-monitor wallpaper is unavailable on this machine — the IDesktopWallpaper COM class has no registered server, so a change here applies to every display."/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Brightness" Description="{x:Bind BrightnessBackend}"
                                 Visibility="{x:Bind BrightnessVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Named per display: two identically-labelled sliders on
                         one page are indistinguishable to a screen reader. -->
                    <Slider Value="{x:Bind BrightnessPercent, Mode=TwoWay}"
                            Minimum="0" Maximum="100" StepFrequency="1"
                            Width="220" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind BrightnessAutomationName}"/>
                    <TextBlock Text="{x:Bind BrightnessPercent, Mode=OneWay}"
                               VerticalAlignment="Center" MinWidth="32"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Brightness"
                                 Description="This display does not report brightness control."
                                 Visibility="{x:Bind NoBrightnessVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Unavailable" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="HDR" Description="{x:Bind HdrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind HdrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind HdrEnabled, Mode=TwoWay}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="HDR" Description="{x:Bind HdrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind NoHdrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Not supported" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Scale"
                                 Description="Applies immediately. Some apps only pick up a scale change when restarted."
                                 Visibility="{x:Bind ScalingVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind ScalingOptions}"
                            SelectedItem="{x:Bind SelectedScaling, Mode=TwoWay}"
                            MinWidth="140"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Scale" Description="Windows did not report scaling steps for this display."
                                 Visibility="{x:Bind NoScalingVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="{x:Bind ScaleText}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Resolution"
                                 Description="Changing resolution forces a full mode switch, so the screen will blank briefly.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind Resolutions}"
                            SelectedItem="{x:Bind SelectedResolution, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Refresh rate"
                                 Description="Changing only the rate is submitted as a timing change, which most drivers apply without blanking.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind RefreshRates}"
                            SelectedItem="{x:Bind SelectedRefreshRate, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Variable refresh rate"
                                 Description="{x:Bind VrrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind VrrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind VrrEnabled, Mode=TwoWay}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Variable refresh rate"
                                 Description="{x:Bind VrrDescription, Mode=OneWay}"
                                 Visibility="{x:Bind NoVrrVisibility, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <TextBlock Text="Not supported" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Orientation" Description="Rotating swaps the resolution automatically.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7AD;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ComboBox ItemsSource="{x:Bind Orientations}"
                            SelectedItem="{x:Bind SelectedOrientation, Mode=TwoWay}"
                            MinWidth="180"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Colour profile" Description="{x:Bind ColorProfileName, Mode=OneWay}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Manage…" Click="OnColorManagement"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Main display" Description="{x:Bind RoleAndConnection}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9CE;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Grid>
                    <Button Content="Make this my main display"
                            Click="OnMakePrimary" Tag="{x:Bind}"
                            Visibility="{x:Bind SetPrimaryVisibility, Mode=OneWay}"/>
                    <TextBlock Text="This is your main display"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind IsPrimaryVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </Grid>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Hide the taskbar" Description="{x:Bind HideTaskbarDescription}">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Grid>
                    <ToggleSwitch IsOn="{x:Bind HideTaskbar, Mode=TwoWay}"
                                  Visibility="{x:Bind ToggleVisibility}"/>
                    <!-- The primary display gets Windows' own auto-hide here,
                         rather than a dead control and a pointer elsewhere. -->
                    <ToggleSwitch IsOn="{x:Bind PrimaryAutoHide, Mode=TwoWay}"
                                  Visibility="{x:Bind PrimaryNoteVisibility}"/>
                  </Grid>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Reclaim the work area"
                                 Description="Let maximised windows fill the whole panel once its taskbar is hidden.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9A6;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <ToggleSwitch IsOn="{x:Bind ReclaimWorkArea, Mode=TwoWay}"
                                IsEnabled="{x:Bind CanHideTaskbar}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Reset this display"
                                 Description="Returns Umbra's own settings to their defaults. Resolution, refresh rate, HDR and scale belong to Windows and are left alone.">
                  <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE777;"/>
                  </tk:SettingsCard.HeaderIcon>
                  <Button Content="Reset" Click="OnResetDisplay" Tag="{x:Bind}"/>
                </tk:SettingsCard>

                <tk:SettingsCard Visibility="{x:Bind ModeStatusVisibility, Mode=OneWay}"
                                 ContentAlignment="Vertical">
                  <TextBlock Text="{x:Bind ModeStatus, Mode=OneWay}"
                             Margin="0,0,0,8"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </tk:SettingsCard>

              </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>

    </StackPanel>
  </ScrollViewer>
</Page>
