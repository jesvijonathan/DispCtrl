<Page x:Class="Umbra.App.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">

  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="0" MaxWidth="1000">

      <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="Umbra"
                 Style="{StaticResource BodyTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Margin="0,4,0,28"/>

      <tk:SettingsCard Header="Version" Description="{x:Bind Version}">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE946;"/>
        </tk:SettingsCard.HeaderIcon>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Runtime" Description="{x:Bind Runtime}">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE950;"/>
        </tk:SettingsCard.HeaderIcon>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Windows" Description="{x:Bind OsVersion}">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE770;"/>
        </tk:SettingsCard.HeaderIcon>
      </tk:SettingsCard>

      <TextBlock Text="How it is built"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,8"/>

      <tk:SettingsCard ContentAlignment="Left">
        <TextBlock TextWrapping="Wrap" MaxWidth="720"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
          Umbra is two processes. This panel is a WinUI 3 app that runs only while you
          have it open. The work is done by a small background engine, which is the part
          that stays resident — so closing this window costs nothing and changes nothing.
          <LineBreak/><LineBreak/>
          The two never talk directly. The panel writes a settings file; the engine
          watches it. That means the taskbars keep working exactly as configured even if
          this app is never opened again, or crashes while open.
        </TextBlock>
      </tk:SettingsCard>

      <tk:SettingsCard Header="Third-party components"
                       Description="Windows App SDK · Windows Community Toolkit · CsWin32">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE8F1;"/>
        </tk:SettingsCard.HeaderIcon>
      </tk:SettingsCard>

    </StackPanel>
  </ScrollViewer>
</Page>
