<Page x:Class="Umbra.App.Views.PresetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:vm="using:Umbra.App.ViewModels"
      xmlns:views="using:Umbra.App.Views"
      Loaded="OnLoaded">

  <ScrollViewer Padding="0,0,0,32">
    <StackPanel Padding="36,12,36,0" Spacing="0" HorizontalAlignment="Stretch">

      <StackPanel Spacing="4" Margin="0,0,0,20">
        <TextBlock Text="Presets" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="Named snapshots of the whole desk. One file each, so a preset can be copied, mailed or kept in a repo."
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
               Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
               Title="No presets yet"
               Message="Get the displays how you want them, then save the desk as a preset below."/>

      <tk:SettingsCard Header="Save the desk as a preset"
                       Description="Captures the whole desk exactly as it is: every display's resolution, refresh rate, position, scaling, HDR, brightness, warmth, wallpaper, the monitor's own settings, and how the taskbar behaves.">
        <tk:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE74E;"/>
        </tk:SettingsCard.HeaderIcon>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="NewName" PlaceholderText="Name" MinWidth="200"
                   AutomationProperties.Name="NewPresetName"/>
          <Button Content="Save as new" Style="{StaticResource AccentButtonStyle}"
                  Click="OnSaveAs" AutomationProperties.Name="SaveAsNewPreset"/>
        </StackPanel>
      </tk:SettingsCard>

      <StackPanel Visibility="{x:Bind ViewModel.PresetVisibility, Mode=OneWay}">

        <tk:SettingsExpander Header="Current preset"
                             Description="{x:Bind ViewModel.Status, Mode=OneWay}"
                             Margin="0,4,0,0"
                             IsExpanded="True">
          <tk:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE8FD;"/>
          </tk:SettingsExpander.HeaderIcon>

          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ComboBox ItemsSource="{x:Bind ViewModel.Names}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                      MinWidth="200"
                      AutomationProperties.Name="PresetPicker"/>
            <Button Content="Apply" Style="{StaticResource AccentButtonStyle}"
                    Click="OnApply" AutomationProperties.Name="ApplyPreset"/>
          </StackPanel>

          <tk:SettingsExpander.Items>
            <!-- Drift is a sign, not a paragraph. The list is a press away
                 rather than on the page because it is read once, when deciding
                 between Save and Discard, and then not again — while the two
                 buttons are what the card is actually for. -->
            <tk:SettingsCard Header="Unsaved differences"
                             Description="This preset no longer matches the desk."
                             Visibility="{x:Bind ViewModel.DirtyVisibility, Mode=OneWay}">
              <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
              </tk:SettingsCard.HeaderIcon>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <views:PresetChanges/>
                <Button Content="Save over it" Click="OnSave"
                        AutomationProperties.Name="SavePreset"/>
                <Button Content="Discard" Click="OnDiscard"
                        AutomationProperties.Name="DiscardPreset"/>
              </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Displays in this preset"
                             Description="{x:Bind ViewModel.Details, Mode=OneWay}">
              <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE7F4;"/>
              </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <!-- One menu rather than three cards. Renaming, sharing and
                 deleting are all things done to the file, they are all rare,
                 and three cards of them pushed the two buttons that matter off
                 the bottom of the expander. -->
            <tk:SettingsCard Header="Manage this preset"
                             Description="A preset is one JSON file, so sharing it is sending the file.">
              <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE72D;"/>
              </tk:SettingsCard.HeaderIcon>
              <DropDownButton Content="Actions" AutomationProperties.Name="PresetActions">
                <DropDownButton.Flyout>
                  <MenuFlyout Placement="Bottom">
                    <MenuFlyoutItem Text="Rename…" Click="OnRename"
                                    AutomationProperties.Name="RenamePreset">
                      <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Export…" Click="OnExport"
                                    AutomationProperties.Name="ExportPreset">
                      <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Import…" Click="OnImport"
                                    AutomationProperties.Name="ImportPreset">
                      <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open the presets folder" Click="OnOpenFolder">
                      <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Delete" Click="OnDelete"
                                    AutomationProperties.Name="DeletePreset">
                      <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
            </tk:SettingsCard>
          </tk:SettingsExpander.Items>
        </tk:SettingsExpander>

      </StackPanel>

      <TextBlock Text="Per-app rules"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Margin="0,28,0,4"/>
      <TextBlock Text="The engine watches which app is in front and switches preset when one of these matches. A rule only fires once its app has held the foreground for a couple of seconds, so alt-tabbing past it does nothing."
                 Style="{StaticResource CaptionTextBlockStyle}"
                 TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Margin="0,0,0,8"/>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,8"
               Visibility="{x:Bind ViewModel.RulesEmptyVisibility, Mode=OneWay}"
               Message="No rules yet. Add one, put in an executable name such as devenv or chrome, and pick a preset."/>

      <ItemsControl ItemsSource="{x:Bind ViewModel.Rules}" HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AppRuleViewModel">
            <tk:SettingsCard Description="{x:Bind Summary, Mode=OneWay}" Header="Rule">
              <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE7C4;"/>
              </tk:SettingsCard.HeaderIcon>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Text="{x:Bind Process, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="app.exe" MinWidth="140"
                         AutomationProperties.Name="RuleProcess"/>
                <TextBox Text="{x:Bind Preset, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="preset" MinWidth="140"
                         AutomationProperties.Name="RulePreset"/>
                <TextBox Text="{x:Bind RevertTo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="back to (optional)" MinWidth="140"
                         AutomationProperties.Name="RuleRevertTo"/>
                <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}"/>
                <Button Content="Remove" Click="OnRemoveRule" Tag="{x:Bind}"/>
              </StackPanel>
            </tk:SettingsCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Content="Add a rule" Click="OnAddRule" Margin="0,8,0,0"
              AutomationProperties.Name="AddRule"/>

      <InfoBar x:Name="Toast" IsOpen="False" IsClosable="True" Severity="Success"
               Margin="0,16,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Page>
