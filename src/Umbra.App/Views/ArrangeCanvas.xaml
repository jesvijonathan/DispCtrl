<UserControl x:Class="Umbra.App.Views.ArrangeCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- MinHeight rather than Height, and stretched: a fixed height collapsed the
       surface when the card was narrow, and left it stranded at 220px when the
       window was maximised. -->
  <Border CornerRadius="6"
          MinHeight="300"
          HorizontalAlignment="Stretch"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderThickness="1"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

    <!-- The controls live inside the surface, the way Windows puts Identify
         and the topology picker inside its arrangement box. Outside, they read
         as page furniture that happens to sit near the diagram; inside, they
         are plainly the diagram's own controls. -->
    <Grid RowSpacing="8" Padding="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Canvas x:Name="Surface" Grid.Row="0" SizeChanged="OnSurfaceSizeChanged"/>

      <Grid Grid.Row="1" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Hint" Grid.Column="0"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Drag a display to move it. It snaps flush against its neighbour."/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Identify" Click="OnIdentify"
                  AutomationProperties.Name="Identify"/>
          <Button Content="Reset" Click="OnReset"/>
          <Button x:Name="ApplyButton" Content="Apply"
                  Style="{StaticResource AccentButtonStyle}"
                  IsEnabled="False" Click="OnApply"
                  AutomationProperties.Name="Apply arrangement"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
