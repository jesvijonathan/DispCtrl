<Window x:Class="Umbra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

  <!-- Mica is what makes a window read as part of Windows 11 rather than as an
       app drawn on top of it: it tints with the desktop behind and with the
       system theme, for free. -->
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt"/>
  </Window.SystemBackdrop>

  <Grid RowDefinitions="Auto,*">

    <!-- The window's own chrome is extended into the client area and this
         stands in for it, so the Mica runs all the way to the top. The left
         inset clears NavigationView's own back/menu buttons. -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="44" ColumnDefinitions="Auto,*">
      <TextBlock Grid.Column="0"
                 Text="Umbra"
                 Margin="96,0,0,0"
                 VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}"/>
    </Grid>

    <muxc:NavigationView x:Name="Nav"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         IsPaneToggleButtonVisible="True"
                         CompactModeThresholdWidth="0"
                         ExpandedModeThresholdWidth="1100"
                         IsBackButtonVisible="Collapsed"
                         IsTitleBarAutoPaddingEnabled="False"
                         OpenPaneLength="220"
                         SelectionChanged="OnNavigationSelectionChanged">

      <muxc:NavigationView.MenuItems>
        <muxc:NavigationViewItem Content="Displays" Tag="displays" IsSelected="True">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7F4;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Taskbar" Tag="taskbar">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7C4;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Presets" Tag="presets">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8FD;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Hotkeys" Tag="hotkeys">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE765;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="Engine" Tag="engine">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE945;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItemSeparator/>

        <muxc:NavigationViewItem Content="Help" Tag="help">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE897;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>

        <muxc:NavigationViewItem Content="About" Tag="about">
          <muxc:NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE946;"/>
          </muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
      </muxc:NavigationView.MenuItems>

      <Frame x:Name="ContentFrame"/>
    </muxc:NavigationView>
  </Grid>
</Window>
